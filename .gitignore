## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/
*.cache
*.sln.cache

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/
*.sln.iml

# OpenCode / AI tools
.opencode/
.agents/
.claude/
Claude/
opensettings.json
skills-lock.json

# Scratch / temp files
New Text Document.txt

# Environment & secrets
.env
.env.*
*.env
appsettings.Development.json
appsettings.*.json
!appsettings.json

# Project documentation (local/dev-specific)
Claude.md
CLAUDE.md
Learnings.md
AGENTS.md
Requirements/

# Frontend prototypes (static HTML design files, not served at runtime)
Frontend/

# .NET Core
*.dll
*.pdb
*.exe
*.dll.config
*.deps.json
*.runtimeconfig.json
*.runtimeconfig.dev.json
*.nuget.props
*.nuget.targets

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Node (if using npm for frontend tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage.json
coverage*.json
coverage*.info

# Entity Core Migrations (uncomment if you want to ignore migrations)
# Migrations/

# Database files (SQLite, etc.)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Web publish profiles (if using file-based secrets)
Properties/PublishProfiles/

# SSL certificates
*.pfx
*.p12

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Package manager locks (optional - uncomment if you don't want to track them)
# package-lock.json
# yarn.lock
