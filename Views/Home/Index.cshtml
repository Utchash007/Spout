@model Twit.Models.ViewModels.HomeFeedViewModel
@{
    Layout = null;
    ViewData["Title"] = "Home";
    ViewData["ActiveNav"] = "home";
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sprout — Home</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* ── ADDITIONAL TOKENS ── */
    :root {
      /* Sidebar widths */
      --sidebar-w:   240px;
      --sidebar-col: 64px;
      --sidebar-r:   280px;
    }

    /* ── BASE ── */
    body {
      background: var(--cream);
      font-family: 'Nunito', system-ui, sans-serif;
      color: var(--text);
      min-height: 100vh;
    }

    /* All interactive elements inherit the font */
    button, input, textarea, select {
      font-family: inherit;
    }

    /* ── LAYOUT ── */
    .layout {
      display: grid;
      grid-template-columns: 1fr;
      margin-left: var(--sidebar-w);
      margin-right: var(--sidebar-r);
      min-height: calc(100vh - 60px);
      transition: margin-left var(--t-layout);
    }
    .layout.collapsed {
      margin-left: var(--sidebar-col);
    }

    /* ── LEFT SIDEBAR ── */
    .sidebar-left {
      position: fixed;
      left: 0;
      top: 60px;
      width: var(--sidebar-w);
      height: calc(100vh - 60px);
      background: var(--cream);
      border-right: var(--border);
      padding: 20px 12px 16px;
      overflow-y: auto;
      overflow-x: hidden;
      z-index: 50;
      display: flex;
      flex-direction: column;
      transition: width var(--t-layout);
    }
    .sidebar-left.collapsed {
      width: var(--sidebar-col);
    }

    /* Label/text visibility when collapsed */
    .sidebar-left .nav-item span,
    .sidebar-left .sidebar-section h4,
    .sidebar-left .btn-post span,
    .sidebar-left .toggle-label {
      opacity: 1;
      max-width: 200px;
      overflow: hidden;
      white-space: nowrap;
      transition: opacity var(--t-ui) 0.05s, max-width var(--t-ui) 0.05s;
    }
    .sidebar-left.collapsed .nav-item span,
    .sidebar-left.collapsed .sidebar-section h4,
    .sidebar-left.collapsed .btn-post span,
    .sidebar-left.collapsed .toggle-label {
      opacity: 0;
      max-width: 0;
      transition: opacity var(--t-ui), max-width var(--t-ui);
    }
    .sidebar-left.collapsed .item-count { display: none; }
    .sidebar-left.collapsed .nav-item {
      justify-content: center;
      padding: 11px;
    }
    .sidebar-left.collapsed .btn-post {
      border-radius: var(--r-pill);
      padding: 12px;
      min-width: 40px;
    }
    .sidebar-left.collapsed .sidebar-section { margin-top: 16px; }
    .sidebar-left.collapsed .sidebar-toggle { justify-content: center; }

    /* Nav menu */
    .nav-menu {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 14px;
      border-radius: var(--r-elem);
      text-decoration: none;
      color: var(--muted);
      font-size: 0.93rem;
      font-weight: 600;
      transition: background var(--t-ui), color var(--t-ui);
    }
    .nav-item:hover { background: var(--sage-lt); color: var(--text); }
    .nav-item.active {
      background: var(--sage-dk);
      color: var(--cream);
      font-weight: 800;
    }
    .nav-item svg { flex-shrink: 0; }
    .nav-item .item-count {
      margin-left: auto;
      font-size: 0.72rem;
      background: var(--sage-md);
      color: var(--white);
      border-radius: var(--r-pill);
      padding: 2px 7px;
      font-weight: 800;
    }
    .nav-item.active .item-count { background: rgba(241, 243, 224, 0.3); }

    .sidebar-section { margin-top: 28px; }
    .sidebar-section h4 {
      font-size: 0.72rem;
      font-weight: 800;
      color: var(--sage-md);
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 0 14px;
      margin-bottom: 8px;
    }

    /* New Sprout button */
    .btn-post {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 12px 16px;
      margin-top: 20px;
      background: var(--sage-dk);
      color: var(--cream);
      border: none;
      border-radius: var(--r-pill);
      font-size: 0.92rem;
      font-weight: 800;
      cursor: pointer;
      transition: background var(--t-ui), transform var(--t-ui), border-radius var(--t-layout), padding var(--t-layout);
      box-shadow: var(--shadow-btn);
      flex-shrink: 0;
    }
    .btn-post:hover { background: var(--sage-xdk); transform: translateY(-1px); }
    .btn-post:active { transform: translateY(0); }

    /* Sidebar toggle */
    .sidebar-toggle {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding: 10px 14px;
      margin-top: auto;
      border: none;
      border-top: var(--border);
      background: transparent;
      cursor: pointer;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 700;
      transition: background var(--t-ui), color var(--t-ui);
      flex-shrink: 0;
    }
    .sidebar-toggle:hover { background: var(--sage-lt); color: var(--sage-dk); }
    .sidebar-toggle .toggle-icon {
      width: 28px;
      height: 28px;
      border-radius: var(--r-sm);
      background: var(--sage-lt);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background var(--t-ui);
    }
    .sidebar-toggle:hover .toggle-icon { background: var(--sage-md); }

    /* ── MAIN FEED ── */
    .feed {
      border-left: var(--border);
      border-right: var(--border);
      background: var(--white);
    }

    .feed-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 20px 14px;
      border-bottom: var(--border);
      position: sticky;
      top: 60px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(8px);
      z-index: 10;
    }
    .feed-header h2 {
      font-size: 1.1rem;
      font-weight: 900;
      color: var(--sage-dk);
      letter-spacing: -0.3px;
    }
    .feed-tabs {
      display: flex;
      gap: 4px;
    }
    .feed-tab {
      padding: 6px 16px;
      border-radius: var(--r-pill);
      border: none;
      background: transparent;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--muted);
      cursor: pointer;
      transition: background var(--t-ui), color var(--t-ui);
    }
    .feed-tab.active {
      background: var(--sage-dk);
      color: var(--cream);
    }
    .feed-tab:hover:not(.active) { background: var(--sage-lt); color: var(--text); }

    /* Stories */
    .stories-bar {
      display: flex;
      gap: 12px;
      padding: 16px 20px;
      overflow-x: auto;
      border-bottom: var(--border);
      scrollbar-width: none;
    }
    .stories-bar::-webkit-scrollbar { display: none; }

    .story {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
      cursor: pointer;
    }
    .story-ring {
      width: 58px;
      height: 58px;
      border-radius: var(--r-pill);
      padding: 2.5px;
      background: linear-gradient(135deg, var(--sage-dk), var(--sage-md));
    }
    .story-ring.add-story { background: var(--sage-lt); }
    .story-avatar {
      width: 100%;
      height: 100%;
      border-radius: var(--r-pill);
      background: var(--sage-md);
      border: 2.5px solid var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--white);
      font-weight: 800;
      font-size: 1rem;
      overflow: hidden;
    }
    .story-avatar.add {
      background: var(--cream);
      color: var(--sage-dk);
      font-size: 1.4rem;
      font-weight: 500;
    }
    .story-name {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--muted);
      text-align: center;
      max-width: 58px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* Compose box */
    .compose-box {
      padding: 16px 20px;
      border-bottom: var(--border);
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }
    .compose-avatar {
      width: 42px;
      height: 42px;
      border-radius: var(--r-pill);
      background: var(--sage-md);
      flex-shrink: 0;
      border: 2px solid var(--sage-dk);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--white);
      font-weight: 800;
    }
    .compose-content { flex: 1; }
    .compose-input {
      width: 100%;
      border: none;
      background: transparent;
      font-size: 0.95rem;
      color: var(--text);
      resize: none;
      outline: none;
      line-height: 1.55;
      min-height: 44px;
    }
    .compose-input::placeholder { color: var(--faint); }
    .compose-actions {
      display: flex;
      align-items: center;
      gap: 4px;
      margin-top: 10px;
      padding-top: 10px;
      border-top: var(--border);
    }
    .compose-action-btn {
      border: none;
      background: none;
      cursor: pointer;
      color: var(--sage-dk);
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 5px 10px;
      border-radius: var(--r-sm);
      transition: background var(--t-ui);
    }
    .compose-action-btn:hover { background: var(--sage-lt); }

    .btn-sprout {
      margin-left: auto;
      padding: 8px 22px;
      background: var(--sage-dk);
      color: var(--cream);
      border: none;
      border-radius: var(--r-pill);
      font-size: 0.88rem;
      font-weight: 800;
      cursor: pointer;
      box-shadow: var(--shadow-btn);
      transition: background var(--t-ui), transform var(--t-ui);
    }
    .btn-sprout:hover { background: var(--sage-xdk); transform: translateY(-1px); }
    .btn-sprout:active { transform: translateY(0); }

    /* ── CREATE POST MODAL ── */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(44, 48, 40, 0.45);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      z-index: 1000;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: min(12vh, 120px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }
    .modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .modal-card {
      background: var(--white);
      border-radius: var(--r-card);
      width: min(560px, 92vw);
      box-shadow: 0 24px 64px rgba(94, 109, 90, 0.22), 0 0 0 1px rgba(210, 220, 182, 0.3);
      transform: translateY(12px) scale(0.97);
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      overflow: hidden;
    }
    .modal-overlay.active .modal-card {
      transform: translateY(0) scale(1);
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: var(--border);
    }
    .modal-header h3 {
      font-size: 1.05rem;
      font-weight: 900;
      color: var(--sage-dk);
      letter-spacing: -0.2px;
    }
    .modal-close {
      width: 34px;
      height: 34px;
      border-radius: var(--r-pill);
      border: none;
      background: var(--cream);
      cursor: pointer;
      color: var(--sage-dk);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background var(--t-ui);
    }
    .modal-close:hover { background: var(--sage-lt); }

    .modal-body {
      padding: 20px;
      display: flex;
      gap: 14px;
    }
    .modal-avatar {
      width: 46px;
      height: 46px;
      border-radius: var(--r-pill);
      background: var(--sage-md);
      border: 2px solid var(--sage-dk);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--white);
      font-weight: 800;
      font-size: 0.95rem;
      flex-shrink: 0;
    }
    .modal-compose {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .modal-textarea {
      width: 100%;
      border: none;
      background: transparent;
      font-family: 'Nunito', system-ui, sans-serif;
      font-size: 1.05rem;
      color: var(--text);
      resize: none;
      outline: none;
      line-height: 1.6;
      min-height: 120px;
      font-weight: 500;
    }
    .modal-textarea::placeholder { color: var(--faint); }

    .modal-footer {
      padding: 14px 20px;
      border-top: var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(241, 243, 224, 0.35);
    }
    .modal-tools {
      display: flex;
      gap: 2px;
    }
    .modal-tool-btn {
      width: 36px;
      height: 36px;
      border-radius: var(--r-sm);
      border: none;
      background: transparent;
      cursor: pointer;
      color: var(--sage-dk);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background var(--t-ui);
    }
    .modal-tool-btn:hover { background: var(--sage-lt); }

    .modal-char-count {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--faint);
      margin-right: 12px;
    }
    .modal-char-count.warn { color: var(--accent); }

    .modal-submit {
      padding: 9px 24px;
      background: var(--sage-dk);
      color: var(--cream);
      border: none;
      border-radius: var(--r-pill);
      font-size: 0.88rem;
      font-weight: 800;
      font-family: 'Nunito', system-ui, sans-serif;
      cursor: pointer;
      box-shadow: var(--shadow-btn);
      transition: background var(--t-ui), transform var(--t-ui), opacity var(--t-ui);
    }
    .modal-submit:hover:not(:disabled) { background: var(--sage-xdk); transform: translateY(-1px); }
    .modal-submit:disabled { opacity: 0.5; cursor: not-allowed; }

    /* Post card */
    .post-card {
      padding: 18px 20px;
      border-bottom: var(--border);
      background: var(--white);
      transition: background var(--t-ui);
    }
    .post-card:hover { background: var(--cream); }

    .post-header {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 10px;
    }
    .post-avatar {
      width: 44px;
      height: 44px;
      border-radius: var(--r-pill);
      flex-shrink: 0;
      border: 2px solid var(--sage-lt);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.95rem;
    }
    .post-avatar.color-a { background: var(--sage-md);   color: var(--white); }
    .post-avatar.color-b { background: var(--sage-dk);   color: var(--cream); }
    .post-avatar.color-c { background: var(--sage-lt);   color: var(--sage-xdk); }
    .post-avatar.color-d { background: var(--sage-mid2); color: var(--white); }

    .post-meta { flex: 1; }
    .post-name {
      font-weight: 800;
      font-size: 0.95rem;
      color: var(--text);
    }
    .post-handle {
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--muted);
    }

    .post-more {
      width: 32px;
      height: 32px;
      border-radius: var(--r-pill);
      border: none;
      background: transparent;
      cursor: pointer;
      color: var(--muted);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background var(--t-ui), color var(--t-ui);
      flex-shrink: 0;
    }
    .post-more:hover { background: var(--sage-lt); color: var(--sage-dk); }

    .post-text {
      font-size: 0.95rem;
      line-height: 1.65;
      color: var(--text);
      margin-bottom: 12px;
      font-weight: 500;
    }
    .post-text .hashtag { color: var(--sage-dk); font-weight: 700; }

    .post-image {
      width: 100%;
      border-radius: var(--r-card);
      aspect-ratio: 16 / 9;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
    }

    .post-actions {
      display: flex;
      align-items: center;
    }
    .post-action {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 7px 12px 7px 8px;
      border: none;
      background: none;
      cursor: pointer;
      color: var(--muted);
      font-size: 0.85rem;
      font-weight: 600;
      border-radius: var(--r-pill);
      transition: background var(--t-ui), color var(--t-ui);
    }
    .post-action:hover { background: var(--sage-lt); }
    .post-action.liked { color: var(--accent); }
    .post-action.liked:hover { background: rgba(224, 122, 95, 0.1); }
    .post-action.bookmarked { color: var(--sage-dk); }
    .post-action--push { margin-left: auto; }

    /* ── RIGHT SIDEBAR ── */
    .sidebar-right {
      position: fixed;
      right: 0;
      top: 60px;
      width: var(--sidebar-r);
      height: calc(100vh - 60px);
      padding: 24px 16px;
      overflow-y: auto;
      background: var(--cream);
      border-left: var(--border);
      z-index: 50;
      scrollbar-width: thin;
      scrollbar-color: var(--sage-lt) transparent;
    }

    .widget {
      background: var(--white);
      border-radius: var(--r-card);
      border: var(--border);
      padding: 18px;
      margin-bottom: 16px;
      box-shadow: var(--shadow-card);
    }
    .widget h3 {
      font-size: 0.9rem;
      font-weight: 900;
      color: var(--sage-dk);
      margin-bottom: 14px;
      letter-spacing: -0.2px;
    }

    /* Trending */
    .trend-item {
      padding: 10px 0;
      border-bottom: var(--border-thin);
      cursor: pointer;
    }
    .trend-item:last-child { border-bottom: none; padding-bottom: 0; }
    .trend-category {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--muted);
      margin-bottom: 3px;
    }
    .trend-tag {
      font-size: 0.9rem;
      font-weight: 800;
      color: var(--text);
      cursor: pointer;
      transition: color var(--t-ui);
    }
    .trend-tag:hover { color: var(--sage-dk); }
    .trend-count {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--muted);
      margin-top: 2px;
    }

    /* Suggested users */
    .suggest-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
    }
    .suggest-item:not(:last-child) { border-bottom: var(--border-thin); }
    .suggest-avatar {
      width: 38px;
      height: 38px;
      border-radius: var(--r-pill);
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.82rem;
      border: var(--border);
    }
    .suggest-info { flex: 1; min-width: 0; }
    .suggest-name {
      font-size: 0.88rem;
      font-weight: 800;
      color: var(--text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .suggest-handle {
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--muted);
    }
    .btn-follow {
      padding: 5px 14px;
      border: 1.5px solid var(--sage-dk);
      border-radius: var(--r-pill);
      background: transparent;
      color: var(--sage-dk);
      font-size: 0.8rem;
      font-weight: 800;
      cursor: pointer;
      transition: background var(--t-ui), color var(--t-ui);
      flex-shrink: 0;
    }
    .btn-follow:hover {
      background: var(--sage-dk);
      color: var(--cream);
    }

    .widget-footer {
      margin-top: 12px;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--sage-md);
      cursor: pointer;
      transition: color var(--t-ui);
    }
    .widget-footer:hover { color: var(--sage-dk); }

    /* Growth widget */
    .mini-widget {
      background: linear-gradient(135deg, var(--sage-dk) 0%, var(--sage-xdk) 100%);
      border-radius: var(--r-card);
      padding: 18px;
      margin-bottom: 16px;
      color: var(--cream);
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-btn);
    }
    .mini-widget::after {
      content: '🌿';
      position: absolute;
      right: -8px;
      bottom: -10px;
      font-size: 5rem;
      opacity: 0.12;
      pointer-events: none;
    }
    .mini-widget h4 { font-size: 0.78rem; font-weight: 700; opacity: 0.8; }
    .mini-widget .stat { font-size: 1.9rem; font-weight: 900; margin: 4px 0; letter-spacing: -1px; }
    .mini-widget p { font-size: 0.8rem; font-weight: 500; opacity: 0.75; }

    .footer-links {
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--faint);
      line-height: 2;
    }
    .footer-links a { color: var(--faint); text-decoration: none; margin-right: 8px; }
    .footer-links a:hover { color: var(--sage-dk); }

    /* ── RESPONSIVE ── */
    @@media (max-width: 900px) {
      .layout {
        margin-left: var(--sidebar-col);
        margin-right: 0;
      }
      .sidebar-right { display: none; }
      .sidebar-left { width: var(--sidebar-col); }
      .sidebar-left .nav-item span,
      .sidebar-left .sidebar-section h4,
      .sidebar-left .btn-post span,
      .sidebar-left .toggle-label { opacity: 0; max-width: 0; overflow: hidden; }
      .sidebar-left .nav-item { justify-content: center; padding: 11px; }
      .sidebar-left .btn-post { border-radius: var(--r-pill); padding: 12px; }
      .sidebar-left .item-count { display: none; }
      .sidebar-left .sidebar-toggle { justify-content: center; }
    }
    @@media (max-width: 600px) {
      .layout { margin-left: 0; }
      .sidebar-left { display: none; }
    }
  </style>
</head>
<body>

  @await Html.PartialAsync("_Navbar")

  <!-- Layout -->
  <div class="layout" id="mainLayout">

    @await Html.PartialAsync("_SidebarLeft")

    <!-- Main feed -->
    <main class="feed">
      <div class="feed-header">
        <h2>Your Feed</h2>
        <div class="feed-tabs">
          <button class="feed-tab active">For You</button>
          <button class="feed-tab">Following</button>
          <button class="feed-tab">Trending</button>
        </div>
      </div>

      <!-- Stories -->
      <div class="stories-bar">
        <div class="story">
          <div class="story-ring add-story">
            <div class="story-avatar add">+</div>
          </div>
          <div class="story-name">Your Story</div>
        </div>
        <div class="story">
          <div class="story-ring">
            <div class="story-avatar" style="background:var(--sage-dk)">ML</div>
          </div>
          <div class="story-name">Maya L.</div>
        </div>
        <div class="story">
          <div class="story-ring">
            <div class="story-avatar" style="background:var(--sage-md)">JR</div>
          </div>
          <div class="story-name">Jake R.</div>
        </div>
        <div class="story">
          <div class="story-ring">
            <div class="story-avatar" style="background:var(--sage-mid2)">SC</div>
          </div>
          <div class="story-name">Sara C.</div>
        </div>
        <div class="story">
          <div class="story-ring">
            <div class="story-avatar" style="background:var(--muted)">TN</div>
          </div>
          <div class="story-name">Tom N.</div>
        </div>
        <div class="story">
          <div class="story-ring">
            <div class="story-avatar" style="background:var(--warm-tan);color:var(--text)">AW</div>
          </div>
          <div class="story-name">Amy W.</div>
        </div>
        <div class="story">
          <div class="story-ring">
            <div class="story-avatar" style="background:var(--sage-xdk)">DP</div>
          </div>
          <div class="story-name">Dan P.</div>
        </div>
      </div>

      <!-- Compose box (click to open modal) -->
      <div class="compose-box" id="composeBoxTrigger" style="cursor:pointer;">
        <div class="compose-avatar">@Model.CurrentUserInitials</div>
        <div class="compose-content">
          <div class="compose-input" style="min-height:auto;color:var(--faint);user-select:none;">What's sprouting today?</div>
          <div class="compose-actions">
            <button type="button" class="compose-action-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
              </svg>
              Photo
            </button>
            <button type="button" class="compose-action-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/>
              </svg>
              Video
            </button>
            <button type="button" class="compose-action-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
              </svg>
              Feeling
            </button>
            <span class="btn-sprout" style="display:inline-block;text-align:center;">Sprout</span>
          </div>
        </div>
      </div>

      @if (Model.Posts == null || !Model.Posts.Any())
      {
        <div class="post-card" style="text-align:center;padding:40px 20px;color:var(--muted);">
          <p>No sprouts yet — be the first!</p>
        </div>
      }
      else
      {
        @foreach (var post in Model.Posts)
        {
          var timeAgo = (DateTime.UtcNow - post.CreatedAt);
          var timeText = timeAgo.TotalMinutes < 60 ? $"{(int)timeAgo.TotalMinutes}m"
                       : timeAgo.TotalHours < 24 ? $"{(int)timeAgo.TotalHours}h"
                       : $"{(int)timeAgo.TotalDays}d";
        <div class="post-card">
          <div class="post-header">
            <div class="post-avatar color-a">@post.AuthorInitials</div>
            <div class="post-meta">
              <div class="post-name">@post.AuthorName</div>
              <div class="post-handle">@("@")@post.AuthorHandle · @timeText</div>
            </div>
            <form asp-action="DeletePost" method="post" style="display:inline">
              <input type="hidden" name="postId" value="@post.Id" />
              <button type="submit" class="post-more" title="Delete post">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
                </svg>
              </button>
            </form>
          </div>
          <p class="post-text">@post.Content</p>
          <div class="post-actions">
            <form asp-action="LikePost" asp-controller="Like" method="post" style="display:inline">
              <input type="hidden" name="postId" value="@post.Id" />
              <button type="submit" class="post-action">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
                @post.LikesCount
              </button>
            </form>
            <button class="post-action">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
              0
            </button>
            <form asp-action="RePost" method="post" style="display:inline">
              <input type="hidden" name="postId" value="@post.Id" />
              <button type="submit" class="post-action">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                </svg>
                @post.RepostCount
              </button>
            </form>
            <button class="post-action post-action--push">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
              </svg>
            </button>
          </div>
        </div>
        }
      }

    </main>

    @await Html.PartialAsync("_SidebarRight")
  </div>

  <!-- Create Post Modal -->
  <div class="modal-overlay" id="createPostModal">
    <div class="modal-card">
      <div class="modal-header">
        <h3>New Sprout</h3>
        <button class="modal-close" id="modalClose" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <form asp-action="CreatePost" method="post">
        <div class="modal-body">
          <div class="modal-avatar">@Model.CurrentUserInitials</div>
          <div class="modal-compose">
            <textarea class="modal-textarea" name="content" id="modalTextarea" placeholder="What's sprouting today?" autofocus></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <div class="modal-tools">
            <button type="button" class="modal-tool-btn" title="Photo">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
              </svg>
            </button>
            <button type="button" class="modal-tool-btn" title="Video">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/>
              </svg>
            </button>
            <button type="button" class="modal-tool-btn" title="Feeling">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
              </svg>
            </button>
          </div>
          <div style="display:flex;align-items:center;gap:8px;">
            <span class="modal-char-count" id="charCount">0 / 500</span>
            <button type="submit" class="modal-submit" id="modalSubmit" disabled>Sprout</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Modal logic
    const modal = document.getElementById('createPostModal');
    const modalTextarea = document.getElementById('modalTextarea');
    const modalClose = document.getElementById('modalClose');
    const modalSubmit = document.getElementById('modalSubmit');
    const charCount = document.getElementById('charCount');
    const trigger = document.getElementById('composeBoxTrigger');

    function openModal() {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
      setTimeout(() => modalTextarea.focus(), 100);
    }
    function closeModal() {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }

    trigger.addEventListener('click', openModal);
    modalClose.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    modalTextarea.addEventListener('input', () => {
      const len = modalTextarea.value.length;
      charCount.textContent = len + ' / 500';
      charCount.classList.toggle('warn', len > 450);
      modalSubmit.disabled = len === 0 || len > 500;
    });
  </script>

  <script>
    const sidebar    = document.getElementById('sidebar');
    const layout     = document.getElementById('mainLayout');
    const toggleBtn  = document.getElementById('sidebarToggle');
    const toggleIcon = document.getElementById('toggleIcon');
    const toggleLabel = toggleBtn.querySelector('.toggle-label');

    let collapsed = false;

    toggleBtn.addEventListener('click', () => {
      collapsed = !collapsed;
      sidebar.classList.toggle('collapsed', collapsed);
      layout.classList.toggle('collapsed', collapsed);

      if (collapsed) {
        toggleIcon.innerHTML = '<polyline points="9 18 15 12 9 6"/>';
        toggleLabel.textContent = 'Expand';
        toggleBtn.title = 'Expand sidebar';
      } else {
        toggleIcon.innerHTML = '<polyline points="15 18 9 12 15 6"/>';
        toggleLabel.textContent = 'Collapse';
        toggleBtn.title = 'Collapse sidebar';
      }
    });
  </script>
</body>
</html>
