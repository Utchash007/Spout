@model IEnumerable<Twit.Models.ViewModels.NotificationViewModel>
@{
    Layout = null;
    ViewData["Title"] = "Notifications";
    ViewData["ActiveNav"] = "notifications";
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sprout — Notifications</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --sidebar-w:   240px;
      --sidebar-col: 64px;
      --sidebar-r:   280px;
    }

    body {
      background: var(--cream);
      font-family: 'Nunito', system-ui, sans-serif;
      color: var(--text);
      min-height: 100vh;
    }

    button, input, textarea, select { font-family: inherit; }

    /* ── LAYOUT ── */
    .layout {
      display: grid;
      grid-template-columns: 1fr;
      margin-left: var(--sidebar-w);
      margin-right: var(--sidebar-r);
      min-height: calc(100vh - 60px);
      transition: margin-left var(--t-layout);
    }
    .layout.collapsed { margin-left: var(--sidebar-col); }

    /* ── LEFT SIDEBAR ── */
    .sidebar-left {
      position: fixed;
      left: 0;
      top: 60px;
      width: var(--sidebar-w);
      height: calc(100vh - 60px);
      background: var(--cream);
      border-right: var(--border);
      padding: 20px 12px 16px;
      overflow-y: auto;
      overflow-x: hidden;
      z-index: 50;
      display: flex;
      flex-direction: column;
      transition: width var(--t-layout);
    }
    .sidebar-left.collapsed { width: var(--sidebar-col); }

    .sidebar-left .nav-item span,
    .sidebar-left .sidebar-section h4,
    .sidebar-left .btn-post span,
    .sidebar-left .toggle-label {
      opacity: 1;
      max-width: 200px;
      overflow: hidden;
      white-space: nowrap;
      transition: opacity var(--t-ui) 0.05s, max-width var(--t-ui) 0.05s;
    }
    .sidebar-left.collapsed .nav-item span,
    .sidebar-left.collapsed .sidebar-section h4,
    .sidebar-left.collapsed .btn-post span,
    .sidebar-left.collapsed .toggle-label {
      opacity: 0;
      max-width: 0;
      transition: opacity var(--t-ui), max-width var(--t-ui);
    }
    .sidebar-left.collapsed .item-count { display: none; }
    .sidebar-left.collapsed .nav-item { justify-content: center; padding: 11px; }
    .sidebar-left.collapsed .btn-post { border-radius: var(--r-pill); padding: 12px; min-width: 40px; }
    .sidebar-left.collapsed .sidebar-section { margin-top: 16px; }
    .sidebar-left.collapsed .sidebar-toggle { justify-content: center; }

    .nav-menu { display: flex; flex-direction: column; gap: 4px; }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 14px;
      border-radius: var(--r-elem);
      text-decoration: none;
      color: var(--muted);
      font-size: 0.93rem;
      font-weight: 600;
      transition: background var(--t-ui), color var(--t-ui);
    }
    .nav-item:hover { background: var(--sage-lt); color: var(--text); }
    .nav-item.active { background: var(--sage-dk); color: var(--cream); font-weight: 800; }
    .nav-item svg { flex-shrink: 0; }
    .nav-item .item-count {
      margin-left: auto;
      font-size: 0.72rem;
      background: var(--sage-md);
      color: var(--white);
      border-radius: var(--r-pill);
      padding: 2px 7px;
      font-weight: 800;
    }
    .nav-item.active .item-count { background: rgba(241, 243, 224, 0.3); }

    .sidebar-section { margin-top: 28px; }
    .sidebar-section h4 {
      font-size: 0.72rem;
      font-weight: 800;
      color: var(--sage-md);
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 0 14px;
      margin-bottom: 8px;
    }

    .btn-post {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 12px 16px;
      margin-top: 20px;
      background: var(--sage-dk);
      color: var(--cream);
      border: none;
      border-radius: var(--r-pill);
      font-size: 0.92rem;
      font-weight: 800;
      cursor: pointer;
      transition: background var(--t-ui), transform var(--t-ui), border-radius var(--t-layout), padding var(--t-layout);
      box-shadow: var(--shadow-btn);
      flex-shrink: 0;
    }
    .btn-post:hover { background: var(--sage-xdk); transform: translateY(-1px); }
    .btn-post:active { transform: translateY(0); }

    .sidebar-toggle {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding: 10px 14px;
      margin-top: auto;
      border: none;
      border-top: var(--border);
      background: transparent;
      cursor: pointer;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 700;
      transition: background var(--t-ui), color var(--t-ui);
      flex-shrink: 0;
    }
    .sidebar-toggle:hover { background: var(--sage-lt); color: var(--sage-dk); }
    .sidebar-toggle .toggle-icon {
      width: 28px;
      height: 28px;
      border-radius: var(--r-sm);
      background: var(--sage-lt);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background var(--t-ui);
    }
    .sidebar-toggle:hover .toggle-icon { background: var(--sage-md); }

    /* ── RIGHT SIDEBAR ── */
    .sidebar-right {
      position: fixed;
      right: 0;
      top: 60px;
      width: var(--sidebar-r);
      height: calc(100vh - 60px);
      padding: 24px 16px;
      overflow-y: auto;
      background: var(--cream);
      border-left: var(--border);
      z-index: 50;
      scrollbar-width: thin;
      scrollbar-color: var(--sage-lt) transparent;
    }
    .widget {
      background: var(--white);
      border-radius: var(--r-card);
      border: var(--border);
      padding: 18px;
      margin-bottom: 16px;
      box-shadow: var(--shadow-card);
    }
    .widget h3 { font-size: 0.9rem; font-weight: 900; color: var(--sage-dk); margin-bottom: 14px; letter-spacing: -0.2px; }
    .trend-item { padding: 10px 0; border-bottom: var(--border-thin); cursor: pointer; }
    .trend-item:last-child { border-bottom: none; padding-bottom: 0; }
    .trend-category { font-size: 0.72rem; font-weight: 600; color: var(--muted); margin-bottom: 3px; }
    .trend-tag { font-size: 0.9rem; font-weight: 800; color: var(--text); transition: color var(--t-ui); }
    .trend-tag:hover { color: var(--sage-dk); }
    .trend-count { font-size: 0.75rem; font-weight: 500; color: var(--muted); margin-top: 2px; }
    .suggest-item { display: flex; align-items: center; gap: 10px; padding: 8px 0; }
    .suggest-item:not(:last-child) { border-bottom: var(--border-thin); }
    .suggest-avatar {
      width: 38px; height: 38px; border-radius: var(--r-pill);
      flex-shrink: 0; display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 0.82rem; border: var(--border);
    }
    .suggest-info { flex: 1; min-width: 0; }
    .suggest-name { font-size: 0.88rem; font-weight: 800; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .suggest-handle { font-size: 0.78rem; font-weight: 500; color: var(--muted); }
    .btn-follow {
      padding: 5px 14px; border: 1.5px solid var(--sage-dk);
      border-radius: var(--r-pill); background: transparent; color: var(--sage-dk);
      font-size: 0.8rem; font-weight: 800; cursor: pointer;
      transition: background var(--t-ui), color var(--t-ui); flex-shrink: 0;
    }
    .btn-follow:hover { background: var(--sage-dk); color: var(--cream); }
    .widget-footer { margin-top: 12px; font-size: 0.8rem; font-weight: 700; color: var(--sage-md); cursor: pointer; transition: color var(--t-ui); }
    .widget-footer:hover { color: var(--sage-dk); }
    .mini-widget {
      background: linear-gradient(135deg, var(--sage-dk) 0%, var(--sage-xdk) 100%);
      border-radius: var(--r-card); padding: 18px; margin-bottom: 16px;
      color: var(--cream); position: relative; overflow: hidden; box-shadow: var(--shadow-btn);
    }
    .mini-widget::after { content: '🌿'; position: absolute; right: -8px; bottom: -10px; font-size: 5rem; opacity: 0.12; pointer-events: none; }
    .mini-widget h4 { font-size: 0.78rem; font-weight: 700; opacity: 0.8; }
    .mini-widget .stat { font-size: 1.9rem; font-weight: 900; margin: 4px 0; letter-spacing: -1px; }
    .mini-widget p { font-size: 0.8rem; font-weight: 500; opacity: 0.75; }
    .footer-links { font-size: 0.72rem; font-weight: 500; color: var(--faint); line-height: 2; }
    .footer-links a { color: var(--faint); text-decoration: none; margin-right: 8px; }
    .footer-links a:hover { color: var(--sage-dk); }

    /* ── NOTIFICATIONS MAIN ── */
    .notif-main {
      border-left: var(--border);
      border-right: var(--border);
      background: var(--white);
    }

    .notif-header {
      position: sticky;
      top: 60px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(8px);
      border-bottom: var(--border);
      z-index: 10;
      padding: 18px 20px 0;
    }
    .notif-header h2 {
      font-size: 1.1rem;
      font-weight: 900;
      color: var(--sage-dk);
      letter-spacing: -0.3px;
      margin-bottom: 14px;
    }
    .notif-tabs {
      display: flex;
      gap: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .notif-tabs::-webkit-scrollbar { display: none; }
    .notif-tab {
      padding: 8px 18px;
      border: none;
      background: transparent;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--muted);
      cursor: pointer;
      border-bottom: 2.5px solid transparent;
      transition: color var(--t-ui), border-color var(--t-ui);
      white-space: nowrap;
      flex-shrink: 0;
    }
    .notif-tab.active {
      color: var(--sage-dk);
      border-bottom-color: var(--sage-dk);
    }
    .notif-tab:hover:not(.active) { color: var(--text); }

    /* Notification items */
    .notif-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 16px 20px;
      border-bottom: var(--border-thin);
      background: var(--white);
      transition: background var(--t-ui);
      cursor: pointer;
    }
    .notif-item:hover { background: #f7f9ee; }
    .notif-item.unread { background: #f3f6e2; }
    .notif-item.unread:hover { background: #ecf0d8; }

    .notif-icon-wrap {
      position: relative;
      flex-shrink: 0;
    }
    .notif-avatar {
      width: 44px;
      height: 44px;
      border-radius: var(--r-pill);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.88rem;
      color: var(--white);
      border: 2px solid var(--white);
    }
    .notif-type-icon {
      position: absolute;
      bottom: -2px;
      right: -2px;
      width: 20px;
      height: 20px;
      border-radius: var(--r-pill);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid var(--white);
    }
    .notif-type-icon.like   { background: var(--accent); }
    .notif-type-icon.follow { background: var(--sage-md); }
    .notif-type-icon.repost { background: var(--sage-dk); }
    .notif-type-icon.mention { background: var(--warm-tan); }
    .notif-type-icon.comment { background: var(--sage-mid2); }

    .notif-body { flex: 1; min-width: 0; }
    .notif-text {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text);
      line-height: 1.5;
      margin-bottom: 3px;
    }
    .notif-text strong { font-weight: 800; }
    .notif-time {
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .notif-preview {
      background: var(--cream);
      border: var(--border-thin);
      border-radius: var(--r-sm);
      padding: 8px 12px;
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--muted);
      line-height: 1.5;
    }

    .notif-unread-dot {
      width: 8px;
      height: 8px;
      border-radius: var(--r-pill);
      background: var(--sage-dk);
      flex-shrink: 0;
      margin-top: 8px;
    }

    .notif-mark-all {
      padding: 6px 14px;
      border: 1.5px solid var(--sage-lt);
      border-radius: var(--r-pill);
      background: transparent;
      color: var(--sage-dk);
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      transition: background var(--t-ui), color var(--t-ui);
      white-space: nowrap;
    }
    .notif-mark-all:hover { background: var(--sage-lt); }

    .notif-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    /* ── RESPONSIVE ── */
    @@media (max-width: 900px) {
      .layout { margin-left: var(--sidebar-col); margin-right: 0; }
      .sidebar-right { display: none; }
      .sidebar-left { width: var(--sidebar-col); }
      .sidebar-left .nav-item span,
      .sidebar-left .sidebar-section h4,
      .sidebar-left .btn-post span,
      .sidebar-left .toggle-label { opacity: 0; max-width: 0; overflow: hidden; }
      .sidebar-left .nav-item { justify-content: center; padding: 11px; }
      .sidebar-left .btn-post { border-radius: var(--r-pill); padding: 12px; }
      .sidebar-left .item-count { display: none; }
      .sidebar-left .sidebar-toggle { justify-content: center; }
    }
    @@media (max-width: 600px) {
      .layout { margin-left: 0; }
      .sidebar-left { display: none; }
    }
  </style>
</head>
<body>

  @await Html.PartialAsync("_Navbar")

  <div class="layout" id="mainLayout">

    @await Html.PartialAsync("_SidebarLeft")

    <main class="notif-main">

      <div class="notif-header">
        <div class="notif-header-row">
          <h2>Notifications</h2>
          <form asp-controller="Notifications" asp-action="MarkAllAsRead" method="post" style="display:inline;">
            <button type="submit" class="notif-mark-all">Mark all as read</button>
          </form>
        </div>
        <div class="notif-tabs">
          <button class="notif-tab active">All</button>
          <button class="notif-tab">Mentions</button>
          <button class="notif-tab">Likes</button>
          <button class="notif-tab">Follows</button>
          <button class="notif-tab">Reposts</button>
        </div>
      </div>

      @if (Model != null && Model.Any())
      {
        @foreach (var notification in Model)
        {
          <div class="notif-item @(notification.IsRead ? "" : "unread")" onclick="markAsRead('@notification.Id')">
            <div class="notif-icon-wrap">
              <div class="notif-avatar" style="background:var(--sage-md)">@notification.ActorInitials</div>
              <div class="notif-type-icon @notification.Type.ToLower()">
                @switch (notification.Type)
                {
                  case "Like":
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="white"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    break;
                  case "Follow":
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                    break;
                  case "Repost":
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                    break;
                  case "Comment":
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    break;
                  case "Mention":
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"/></svg>
                    break;
                }
              </div>
            </div>
            <div class="notif-body">
              <div class="notif-text">
                <strong>@notification.ActorName</strong>
                @switch (notification.Type)
                {
                  case "Like": <text>liked your Sprout</text>; break;
                  case "Follow": <text>started following you</text>; break;
                  case "Repost": <text>reposted your Sprout</text>; break;
                  case "Comment": <text>commented on your Sprout</text>; break;
                  case "Mention": <text>mentioned you in a reply</text>; break;
                }
              </div>
              <div class="notif-time">@notification.TimeAgo</div>
              @if (!string.IsNullOrEmpty(notification.PostContent))
              {
                <div class="notif-preview">@notification.PostContent</div>
              }
              else if (!string.IsNullOrEmpty(notification.CommentContent))
              {
                <div class="notif-preview">@notification.CommentContent</div>
              }
            </div>
            @if (!notification.IsRead)
            {
              <div class="notif-unread-dot"></div>
            }
          </div>
        }
      }
      else
      {
        <div style="text-align:center; padding:40px; color:var(--muted);">
          <p>No notifications yet.</p>
        </div>
      }

    </main>

    @await Html.PartialAsync("_SidebarRight")

  </div>

  <script>
    // Sidebar toggle
    const sidebar     = document.getElementById('sidebar');
    const layout      = document.getElementById('mainLayout');
    const toggleBtn   = document.getElementById('sidebarToggle');
    const toggleIcon  = document.getElementById('toggleIcon');
    const toggleLabel = toggleBtn.querySelector('.toggle-label');

    let collapsed = false;

    toggleBtn.addEventListener('click', () => {
      collapsed = !collapsed;
      sidebar.classList.toggle('collapsed', collapsed);
      layout.classList.toggle('collapsed', collapsed);

      if (collapsed) {
        toggleIcon.innerHTML = '<polyline points="9 18 15 12 9 6"/>';
        toggleLabel.textContent = 'Expand';
        toggleBtn.title = 'Expand sidebar';
      } else {
        toggleIcon.innerHTML = '<polyline points="15 18 9 12 15 6"/>';
        toggleLabel.textContent = 'Collapse';
        toggleBtn.title = 'Collapse sidebar';
      }
    });

    // Tab switching
    document.querySelectorAll('.notif-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.notif-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
      });
    });

    function markAsRead(id) {
      const form = document.createElement('form');
      form.method = 'post';
      form.action = '@Url.Action("MarkAsRead", "Notifications")';
      
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'notificationId';
      input.value = id;
      
      form.appendChild(input);
      document.body.appendChild(form);
      form.submit();
    }
  </script>

</body>
</html>
