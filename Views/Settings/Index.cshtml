                <div class="avatar-edit-wrap">
                  <div class="avatar-edit" style="@(string.IsNullOrEmpty(Model.ProfileImage) ? "" : $"background-image: url('{Model.ProfileImage}'); background-size: cover; background-position: center; color: transparent;")">
                    @if (string.IsNullOrEmpty(Model.ProfileImage))
                    {
                        @((Model.FirstName?.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "") + (Model.LastName?.Length > 0 ? Model.LastName[0].ToString().ToUpper() : ""))
                    }
                    <div class="avatar-overlay">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    </div>
                  </div>
                </div>
              </div>
              <div style="padding: 16px 24px 24px;">
                <div class="form-group">
                  <label asp-for="FirstName">First Name</label>
                  <input asp-for="FirstName" type="text" maxlength="50" required />
