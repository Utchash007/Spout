                  <div class="theme-preview" style="background:linear-gradient(135deg,#F1F3E0,#ffffff);border:1.5px solid #D2DCB6;"></div>
                  <div class="theme-name">Light</div>
                </div>
                <div class="theme-card">
                  <div class="theme-preview" style="background:linear-gradient(135deg,#1a1f1a,#2c3028);border:1.5px solid #3a4038;"></div>
                  <div class="theme-name">Dark</div>
                </div>
                <div class="theme-card">
                  <div class="theme-preview" style="background:linear-gradient(135deg,#F1F3E0 50%,#1a1f1a 50%);border:1.5px solid #D2DCB6;"></div>
