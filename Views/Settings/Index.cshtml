@model Twit.Models.ViewModels.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
    Layout = null;
    ViewData["ActiveNav"] = "settings";
    var activePanel = ViewBag.ActivePanel as string ?? "edit-profile";
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sprout — Settings</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cream:      #F1F3E0;
      --sage-lt:    #D2DCB6;
      --sage-md:    #A1BC98;
      --sage-dk:    #778873;
      --sage-xdk:   #5e6d5a;
      --sage-mid2:  #8fb08a;
      --warm-tan:   #c4b59a;
      --white:      #ffffff;
      --text:       #2c3028;
      --muted:      #6b7a67;
      --faint:      #a8b3a5;
      --accent:     #e07a5f;
      --border:     1.5px solid var(--sage-lt);
      --border-thin: 1px solid var(--sage-lt);
      --r-pill:   9999px;
      --r-card:   16px;
      --r-elem:   10px;
      --r-sm:     8px;
      --t-ui:     0.2s ease;
      --t-layout: 0.3s ease;
      --sidebar-w:   240px;
      --sidebar-col: 64px;
      --sidebar-r:   280px;
      --shadow-btn:  0 4px 14px rgba(119,136,115,0.28);
      --shadow-card: 0 2px 8px rgba(119,136,115,0.1);
    }

    body {
      background: var(--cream);
      font-family: 'Nunito', system-ui, sans-serif;
      color: var(--text);
      min-height: 100vh;
    }
    button, input, textarea, select { font-family: inherit; }

    .layout {
      display: grid; grid-template-columns: 1fr;
      margin-left: var(--sidebar-w);
      margin-right: 0;
      min-height: calc(100vh - 60px);
      transition: margin-left var(--t-layout);
    }
    .layout.collapsed { margin-left: var(--sidebar-col); }

    /* ── LEFT SIDEBAR (from _SidebarLeft partial) ── */
    .sidebar-left {
      position: fixed; left: 0; top: 60px;
      width: var(--sidebar-w);
      height: calc(100vh - 60px);
      background: var(--cream); border-right: var(--border);
      padding: 20px 12px 16px;
      overflow-y: auto; overflow-x: hidden;
      z-index: 50;
      display: flex; flex-direction: column;
      transition: width var(--t-layout);
    }
    .sidebar-left.collapsed { width: var(--sidebar-col); }

    .sidebar-left .nav-item span,
    .sidebar-left .sidebar-section h4,
    .sidebar-left .btn-post span,
    .sidebar-left .toggle-label {
      opacity: 1; max-width: 200px;
      overflow: hidden; white-space: nowrap;
      transition: opacity var(--t-ui) 0.05s, max-width var(--t-ui) 0.05s;
    }
    .sidebar-left.collapsed .nav-item span,
    .sidebar-left.collapsed .sidebar-section h4,
    .sidebar-left.collapsed .btn-post span,
    .sidebar-left.collapsed .toggle-label {
      opacity: 0; max-width: 0;
      transition: opacity var(--t-ui), max-width var(--t-ui);
    }
    .sidebar-left.collapsed .item-count { display: none; }
    .sidebar-left.collapsed .nav-item { justify-content: center; padding: 11px; }
    .sidebar-left.collapsed .btn-post { border-radius: var(--r-pill); padding: 12px; min-width: 40px; }
    .sidebar-left.collapsed .sidebar-section { margin-top: 16px; }
    .sidebar-left.collapsed .sidebar-toggle { justify-content: center; }

    .nav-menu { display: flex; flex-direction: column; gap: 4px; }
    .nav-item {
      display: flex; align-items: center; gap: 12px;
      padding: 11px 14px; border-radius: var(--r-elem);
      text-decoration: none; color: var(--muted);
      font-size: 0.93rem; font-weight: 600;
      transition: background var(--t-ui), color var(--t-ui);
    }
    .nav-item:hover { background: var(--sage-lt); color: var(--text); }
    .nav-item.active { background: var(--sage-dk); color: var(--cream); font-weight: 800; }
    .nav-item svg { flex-shrink: 0; }
    .nav-item .item-count {
      margin-left: auto; font-size: 0.72rem;
      background: var(--sage-md); color: var(--white);
      border-radius: var(--r-pill); padding: 2px 7px; font-weight: 800;
    }
    .nav-item.active .item-count { background: rgba(241,243,224,0.3); }

    .sidebar-section { margin-top: 28px; }
    .sidebar-section h4 {
      font-size: 0.72rem; font-weight: 800;
      color: var(--sage-md); text-transform: uppercase;
      letter-spacing: 1px; padding: 0 14px; margin-bottom: 8px;
    }

    .btn-post {
      display: flex; align-items: center; justify-content: center;
      gap: 8px; width: 100%; padding: 12px 16px; margin-top: 20px;
      background: var(--sage-dk); color: var(--cream);
      border: none; border-radius: var(--r-pill);
      font-size: 0.92rem; font-weight: 800; cursor: pointer;
      transition: background var(--t-ui), transform var(--t-ui), border-radius var(--t-layout), padding var(--t-layout);
      box-shadow: var(--shadow-btn); flex-shrink: 0;
    }
    .btn-post:hover { background: var(--sage-xdk); transform: translateY(-1px); }
    .btn-post:active { transform: translateY(0); }

    .sidebar-toggle {
      display: flex; align-items: center; gap: 8px;
      width: 100%; padding: 10px 14px; margin-top: auto;
      border: none; border-top: var(--border);
      background: transparent; cursor: pointer;
      color: var(--muted); font-size: 0.82rem; font-weight: 700;
      transition: background var(--t-ui), color var(--t-ui); flex-shrink: 0;
    }
    .sidebar-toggle:hover { background: var(--sage-lt); color: var(--sage-dk); }
    .sidebar-toggle .toggle-icon {
      width: 28px; height: 28px; border-radius: var(--r-sm);
      background: var(--sage-lt);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; transition: background var(--t-ui);
    }
    .sidebar-toggle:hover .toggle-icon { background: var(--sage-md); }

    .feed {
      border-left: var(--border);
      background: var(--white);
      min-height: calc(100vh - 60px);
    }

    .feed-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 24px 14px;
      border-bottom: var(--border);
      position: sticky; top: 60px;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(8px); z-index: 10;
    }
    .feed-header h2 {
      font-size: 1.1rem; font-weight: 900;
      color: var(--sage-dk); letter-spacing: -0.3px;
    }

    .settings-body {
      display: flex;
      min-height: calc(100vh - 110px);
    }

    .settings-nav {
      width: 220px;
      flex-shrink: 0;
      border-right: var(--border);
      padding: 20px 12px;
      display: flex;
      flex-direction: column;
      gap: 2px;
      background: var(--cream);
    }

    .settings-nav-item {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px;
      border-radius: var(--r-elem);
      border: none; background: transparent;
      color: var(--muted); font-size: 0.9rem; font-weight: 600;
      cursor: pointer; text-align: left; width: 100%;
      transition: background var(--t-ui), color var(--t-ui);
    }
    .settings-nav-item:hover { background: var(--sage-lt); color: var(--text); }
    .settings-nav-item.active { background: var(--sage-dk); color: var(--cream); font-weight: 800; }
    .settings-nav-item svg { flex-shrink: 0; }
    .settings-nav-item.danger { color: var(--accent); }
    .settings-nav-item.danger:hover { background: rgba(224,122,95,0.1); color: var(--accent); }
    .settings-nav-item.danger.active { background: var(--accent); color: var(--white); }

    .settings-panel-area {
      flex: 1;
      padding: 28px 32px;
      overflow-y: auto;
    }

    .settings-panel { display: none; }
    .settings-panel.active { display: block; }

    .panel-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 24px;
    }
    .panel-header h3 {
      font-size: 1rem; font-weight: 900;
      color: var(--text); letter-spacing: -0.2px;
    }

    .form-section {
      background: var(--white);
      border: var(--border);
      border-radius: var(--r-card);
      padding: 24px;
      margin-bottom: 16px;
      box-shadow: var(--shadow-card);
    }
    .form-section-title {
      font-size: 0.78rem; font-weight: 800;
      color: var(--sage-md); text-transform: uppercase;
      letter-spacing: 1px; margin-bottom: 18px;
    }

    .form-group { margin-bottom: 18px; }
    .form-group:last-child { margin-bottom: 0; }
    .form-group label {
      display: block; font-size: 0.82rem; font-weight: 700;
      color: var(--sage-dk); margin-bottom: 7px;
      letter-spacing: 0.3px; text-transform: uppercase;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%; padding: 11px 14px;
      border: var(--border); border-radius: var(--r-elem);
      font-size: 0.93rem; color: var(--text);
      background: var(--cream); outline: none;
      transition: border-color var(--t-ui), box-shadow var(--t-ui), background var(--t-ui);
      appearance: none; -webkit-appearance: none;
    }
    .form-group textarea { resize: vertical; line-height: 1.55; }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--sage-md);
      box-shadow: 0 0 0 3px rgba(161,188,152,0.18);
      background: var(--white);
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder { color: var(--faint); }
    .input-hint {
      font-size: 0.77rem; color: var(--faint);
      margin-top: 5px; font-weight: 500;
    }
    .char-counter {
      font-size: 0.77rem; color: var(--faint);
      margin-top: 5px; text-align: right; font-weight: 600;
    }
    .char-counter.warn { color: var(--accent); }

    .btn-primary {
      padding: 10px 24px;
      background: var(--sage-dk); color: var(--cream);
      border: none; border-radius: var(--r-pill);
      font-size: 0.9rem; font-weight: 800; cursor: pointer;
      transition: background var(--t-ui), transform var(--t-ui);
      box-shadow: var(--shadow-btn);
    }
    .btn-primary:hover { background: var(--sage-xdk); transform: translateY(-1px); }
    .btn-primary:active { transform: translateY(0); }

    .btn-outline {
      padding: 9px 20px;
      background: transparent;
      border: 1.5px solid var(--sage-dk);
      color: var(--sage-dk);
      border-radius: var(--r-pill);
      font-size: 0.88rem; font-weight: 700; cursor: pointer;
      transition: background var(--t-ui), color var(--t-ui);
    }
    .btn-outline:hover { background: var(--sage-dk); color: var(--cream); }

    .btn-outline-accent {
      padding: 10px 24px;
      background: transparent;
      border: 1.5px solid var(--accent);
      color: var(--accent);
      border-radius: var(--r-pill);
      font-size: 0.9rem; font-weight: 700; cursor: pointer;
      transition: background var(--t-ui), color var(--t-ui);
    }
    .btn-outline-accent:hover { background: rgba(224,122,95,0.08); }

    .btn-danger {
      padding: 10px 24px;
      background: var(--accent); color: var(--white);
      border: none; border-radius: var(--r-pill);
      font-size: 0.9rem; font-weight: 700; cursor: pointer;
      transition: background var(--t-ui), transform var(--t-ui);
      box-shadow: 0 4px 14px rgba(224,122,95,0.3);
    }
    .btn-danger:hover { background: #c9634a; transform: translateY(-1px); }

    .btn-sm {
      padding: 6px 16px;
      border-radius: var(--r-pill);
      font-size: 0.8rem; font-weight: 700; cursor: pointer;
      transition: background var(--t-ui), color var(--t-ui);
    }
    .btn-sm-outline {
      background: transparent;
      border: 1.5px solid var(--sage-lt);
      color: var(--muted);
    }
    .btn-sm-outline:hover { border-color: var(--sage-dk); color: var(--sage-dk); }
    .btn-sm-danger {
      background: transparent;
      border: 1.5px solid rgba(224,122,95,0.4);
      color: var(--accent);
    }
    .btn-sm-danger:hover { background: rgba(224,122,95,0.08); }

    .profile-media-edit {
      position: relative;
      margin-bottom: 56px;
    }
    .banner-edit {
      height: 130px;
      background: linear-gradient(135deg, var(--sage-lt) 0%, var(--sage-md) 60%, var(--sage-dk) 100%);
      border-radius: var(--r-card) var(--r-card) 0 0;
      overflow: hidden;
      cursor: pointer;
      position: relative;
      transition: filter var(--t-ui);
    }
    .banner-edit:hover { filter: brightness(0.88); }
    .banner-overlay {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      background: rgba(0,0,0,0.18);
      opacity: 0; transition: opacity var(--t-ui);
    }
    .banner-edit:hover .banner-overlay { opacity: 1; }
    .banner-overlay span {
      background: rgba(0,0,0,0.5);
      color: #fff; font-size: 0.8rem; font-weight: 700;
      padding: 6px 14px; border-radius: var(--r-pill);
      display: flex; align-items: center; gap: 6px;
    }

    .avatar-edit-wrap {
      position: absolute;
      bottom: -44px; left: 24px;
    }
    .avatar-edit {
      width: 80px; height: 80px; border-radius: 50%;
      background: var(--sage-md);
      border: 3px solid var(--white);
      display: flex; align-items: center; justify-content: center;
      color: var(--white); font-weight: 900; font-size: 1.4rem;
      cursor: pointer; position: relative; overflow: hidden;
      transition: filter var(--t-ui);
      box-shadow: 0 2px 12px rgba(119,136,115,0.3);
    }
    .avatar-edit:hover { filter: brightness(0.85); }
    .avatar-overlay {
      position: absolute; inset: 0;
      background: rgba(0,0,0,0.3);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity var(--t-ui); border-radius: 50%;
    }
    .avatar-edit:hover .avatar-overlay { opacity: 1; }

    .toggle-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 0;
      border-bottom: var(--border-thin);
    }
    .toggle-row:last-child { border-bottom: none; padding-bottom: 0; }
    .toggle-info { flex: 1; }
    .toggle-label-text {
      font-size: 0.93rem; font-weight: 700; color: var(--text);
    }
    .toggle-desc {
      font-size: 0.78rem; color: var(--muted); margin-top: 2px; font-weight: 500;
    }
    .toggle-switch {
      position: relative; width: 44px; height: 24px; flex-shrink: 0; margin-left: 16px;
    }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .toggle-slider {
      position: absolute; inset: 0; cursor: pointer;
      background: var(--sage-lt); border-radius: var(--r-pill);
      transition: background var(--t-ui);
    }
    .toggle-slider::before {
      content: ''; position: absolute;
      width: 18px; height: 18px; left: 3px; bottom: 3px;
      background: var(--white); border-radius: 50%;
      transition: transform var(--t-ui);
      box-shadow: 0 1px 4px rgba(0,0,0,0.15);
    }
    .toggle-switch input:checked + .toggle-slider { background: var(--sage-dk); }
    .toggle-switch input:checked + .toggle-slider::before { transform: translateX(20px); }

    .account-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 0; border-bottom: var(--border-thin);
    }
    .account-row:last-child { border-bottom: none; padding-bottom: 0; }
    .account-row-label {
      font-size: 0.82rem; font-weight: 700;
      color: var(--sage-dk); text-transform: uppercase;
      letter-spacing: 0.3px; margin-bottom: 3px;
    }
    .account-row-value {
      font-size: 0.93rem; font-weight: 600; color: var(--text);
    }

    .connected-row {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 0; border-bottom: var(--border-thin);
    }
    .connected-row:last-child { border-bottom: none; }
    .connected-icon {
      width: 36px; height: 36px; border-radius: var(--r-sm);
      background: var(--cream); border: var(--border);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .connected-info { flex: 1; }
    .connected-name { font-size: 0.92rem; font-weight: 700; color: var(--text); }
    .connected-status { font-size: 0.78rem; font-weight: 600; }
    .connected-status.on { color: var(--sage-md); }
    .connected-status.off { color: var(--faint); }

    .session-row {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 0; border-bottom: var(--border-thin);
    }
    .session-row:last-child { border-bottom: none; }
    .session-icon {
      width: 36px; height: 36px; border-radius: var(--r-sm);
      background: var(--cream); border: var(--border);
      display: flex; align-items: center; justify-content: center;
      color: var(--sage-dk); flex-shrink: 0;
    }
    .session-info { flex: 1; }
    .session-device { font-size: 0.92rem; font-weight: 700; color: var(--text); }
    .session-meta { font-size: 0.78rem; color: var(--muted); font-weight: 500; margin-top: 1px; }

    .theme-cards {
      display: flex; gap: 12px; flex-wrap: wrap;
    }
    .theme-card {
      flex: 1; min-width: 100px;
      border: 2px solid var(--sage-lt);
      border-radius: var(--r-card);
      padding: 16px 12px;
      cursor: pointer; text-align: center;
      transition: border-color var(--t-ui), box-shadow var(--t-ui);
      background: var(--white);
    }
    .theme-card.selected {
      border-color: var(--sage-dk);
      box-shadow: 0 0 0 3px rgba(119,136,115,0.15);
    }
    .theme-card .theme-preview {
      width: 48px; height: 32px; border-radius: var(--r-sm);
      margin: 0 auto 10px;
    }
    .theme-card .theme-name {
      font-size: 0.85rem; font-weight: 700; color: var(--text);
    }

    .danger-block {
      display: flex; align-items: flex-start;
      gap: 20px; padding: 20px 0;
      border-bottom: var(--border-thin);
    }
    .danger-block:last-child { border-bottom: none; padding-bottom: 0; }
    .danger-block-info { flex: 1; }
    .danger-block-title { font-size: 0.95rem; font-weight: 800; color: var(--text); margin-bottom: 4px; }
    .danger-block-desc { font-size: 0.82rem; color: var(--muted); font-weight: 500; line-height: 1.5; }

    .notif-group { margin-bottom: 6px; }
    .notif-group-title {
      font-size: 0.82rem; font-weight: 800;
      color: var(--sage-dk); text-transform: uppercase;
      letter-spacing: 0.5px; padding: 10px 0 4px;
      border-bottom: var(--border-thin); margin-bottom: 4px;
    }
    .text-danger {
      color: var(--accent);
      font-size: 0.8rem;
      font-weight: 700;
      margin-top: 5px;
      display: block;
    }
    .validation-summary ul {
      list-style: none;
      padding: 0;
      margin: 0 0 20px 0;
    }
    .validation-summary li {
      color: var(--accent);
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 5px;
    }

    @@media (max-width: 900px) {
      .layout { margin-left: var(--sidebar-col); }
    }
    @@media (max-width: 700px) {
      .settings-nav { width: 100%; border-right: none; border-bottom: var(--border); flex-direction: row; overflow-x: auto; padding: 12px; gap: 4px; }
      .settings-body { flex-direction: column; }
      .settings-panel-area { padding: 20px 16px; }
    }
    @@media (max-width: 600px) {
      .layout { margin-left: 0; }
    }
  </style>
</head>
<body>

  <partial name="_Navbar" />

  <div class="layout" id="mainLayout">

    <partial name="_SidebarLeft" />

    <main class="feed">
      <div class="feed-header">
        <h2>Settings</h2>
      </div>

      <div class="settings-body">

        <nav class="settings-nav">
          <button class="settings-nav-item @(activePanel == "edit-profile" ? "active" : "")" data-panel="edit-profile" type="button">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
            Edit Profile
          </button>
          <button class="settings-nav-item @(activePanel == "account" ? "active" : "")" data-panel="account" type="button">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            Account
          </button>
          <button class="settings-nav-item @(activePanel == "privacy" ? "active" : "")" data-panel="privacy" type="button">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            Privacy &amp; Safety
          </button>
          <button class="settings-nav-item @(activePanel == "notifications" ? "active" : "")" data-panel="notifications" type="button">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            Notifications
          </button>
          <button class="settings-nav-item @(activePanel == "appearance" ? "active" : "")" data-panel="appearance" type="button">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            Appearance
          </button>
          <button class="settings-nav-item danger @(activePanel == "danger" ? "active" : "")" data-panel="danger" type="button">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            Danger Zone
          </button>
        </nav>

        <form asp-action="Update" method="post" id="settingsForm" class="settings-panel-area">
          @Html.AntiForgeryToken()
          <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

          <input type="hidden" asp-for="ProfileImage" />
          <input type="hidden" asp-for="CoverImage" />

          <div class="settings-panel @(activePanel == "edit-profile" ? "active" : "")" id="panel-edit-profile">
