              <h3 style="color:var(--accent);">Danger Zone</h3>
            </div>

            <div class="form-section" style="border-color:rgba(224,122,95,0.25);">
              <div class="danger-block">
                <div class="danger-block-info">
                  <div class="danger-block-title">Deactivate Account</div>
                  <div class="danger-block-desc">Temporarily disable your account. Your profile and posts will be hidden until you reactivate by logging back in.</div>
                </div>
                <button type="button" class="btn-outline-accent">Deactivate</button>
              </div>
              <div class="danger-block">
