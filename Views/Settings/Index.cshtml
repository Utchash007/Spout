                </div>
                <div class="form-group">
                  <label asp-for="LastName">Last Name</label>
                  <input asp-for="LastName" type="text" maxlength="50" required />
                  <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="form-group">
                  <label for="username">Username</label>
                  <input type="text" id="username" value="@@@(ViewBag.Username ?? User.Identity?.Name)" readonly disabled />
