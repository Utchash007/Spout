  <script>
    const sidebar     = document.getElementById('sidebar');
    const layout      = document.getElementById('mainLayout');
    const toggleBtn   = document.getElementById('sidebarToggle');
    const toggleIcon  = document.getElementById('toggleIcon');
    const toggleLabel = toggleBtn ? toggleBtn.querySelector('.toggle-label') : null;
    let collapsed = false;

    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        collapsed = !collapsed;
        sidebar.classList.toggle('collapsed', collapsed);
        layout.classList.toggle('collapsed', collapsed);
        if (collapsed) {
          toggleIcon.innerHTML = '<polyline points="9 18 15 12 9 6"/>';
          if (toggleLabel) toggleLabel.textContent = 'Expand';
          toggleBtn.title = 'Expand sidebar';
        } else {
          toggleIcon.innerHTML = '<polyline points="15 18 9 12 15 6"/>';
          if (toggleLabel) toggleLabel.textContent = 'Collapse';
          toggleBtn.title = 'Collapse sidebar';
        }
      });
    }

    const navItems = document.querySelectorAll('.settings-nav-item');
    const panels   = document.querySelectorAll('.settings-panel');

    navItems.forEach(btn => {
      btn.addEventListener('click', () => {
        navItems.forEach(b => b.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        const panelId = btn.getAttribute('data-panel');
        document.getElementById('panel-' + panelId).classList.add('active');
      });
    });

    const bioInput = document.getElementById('Bio');
    const bioCounter = document.getElementById('bioCounter');
    if (bioInput && bioCounter) {
      const updateCounter = () => {
        const len = bioInput.value.length;
        bioCounter.textContent = len + ' / 160';
        bioCounter.classList.toggle('warn', len > 140);
      };
      bioInput.addEventListener('input', updateCounter);
      updateCounter(); // Run on load
    }

    // Interactive avatar and banner edit support
    const bannerEdit = document.querySelector('.banner-edit');
    const avatarEdit = document.querySelector('.avatar-edit');
    const coverImageInput = document.getElementById('CoverImage');
    const profileImageInput = document.getElementById('ProfileImage');

    if (bannerEdit && coverImageInput) {
      bannerEdit.addEventListener('click', () => {
        const url = prompt('Enter Cover Image URL:', coverImageInput.value || '');
        if (url !== null) {
          coverImageInput.value = url;
          if (url) {
            bannerEdit.style.backgroundImage = `url('${url}')`;
            bannerEdit.style.backgroundSize = 'cover';
            bannerEdit.style.backgroundPosition = 'center';
          } else {
            bannerEdit.style.backgroundImage = '';
          }
        }
      });
    }

    if (avatarEdit && profileImageInput) {
      avatarEdit.addEventListener('click', () => {
        const url = prompt('Enter Profile Image URL:', profileImageInput.value || '');
        if (url !== null) {
          profileImageInput.value = url;
          if (url) {
            avatarEdit.style.backgroundImage = `url('${url}')`;
            avatarEdit.style.backgroundSize = 'cover';
            avatarEdit.style.backgroundPosition = 'center';
            avatarEdit.style.color = 'transparent';
          } else {
            avatarEdit.style.backgroundImage = '';
            avatarEdit.style.color = '';
            // Set initials if empty
            const firstName = document.getElementById('FirstName')?.value || '';
            const lastName = document.getElementById('LastName')?.value || '';
            avatarEdit.textContent = ((firstName[0] || '') + (lastName[0] || '')).toUpperCase();
          }
        }
      });
    }
  </script>

  @if (TempData["SettingsSuccess"] != null)
  {
      <script>
          document.addEventListener('DOMContentLoaded', () => {
              const toast = document.createElement('div');
              toast.className = 'toast-success';
              toast.textContent = 'Profile updated successfully!';
              toast.style.cssText = 'position:fixed;top:80px;right:20px;background:var(--sage-dk);color:var(--cream);padding:12px 24px;border-radius:var(--r-pill);font-weight:700;z-index:9999;transition:opacity 0.3s ease, transform 0.3s ease;transform:translateY(-10px);opacity:0;';
              document.body.appendChild(toast);
              toast.offsetHeight; // force reflow
              toast.style.transform = 'translateY(0)';
              toast.style.opacity = '1';
              setTimeout(() => {
                  toast.style.transform = 'translateY(-10px)';
                  toast.style.opacity = '0';
                  setTimeout(() => toast.remove(), 300);
              }, 3000);
          });
      </script>
  }
</body>
</html>
