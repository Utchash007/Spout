                </div>
                <label class="toggle-switch">
                  <input type="checkbox" checked />
                  <span class="toggle-slider"></span>
                </label>
              </div>
              <div class="toggle-row">
                <div class="toggle-info">
                  <div class="toggle-label-text">Show Read Receipts</div>
                  <div class="toggle-desc">Let people know when you've read their messages</div>
