                <div class="toggle-row">
                  <div class="toggle-info"><div class="toggle-label-text">New Followers</div></div>
                  <label class="toggle-switch"><input type="checkbox" /><span class="toggle-slider"></span></label>
                </div>
                <div class="toggle-row">
                  <div class="toggle-info"><div class="toggle-label-text">Likes</div></div>
                  <label class="toggle-switch"><input type="checkbox" /><span class="toggle-slider"></span></label>
                </div>
                <div class="toggle-row">
                  <div class="toggle-info"><div class="toggle-label-text">Comments</div></div>
                  <label class="toggle-switch"><input type="checkbox" checked /><span class="toggle-slider"></span></label>
                </div>
                <div class="toggle-row">
                  <div class="toggle-info"><div class="toggle-label-text">Reposts</div></div>
                  <label class="toggle-switch"><input type="checkbox" /><span class="toggle-slider"></span></label>
