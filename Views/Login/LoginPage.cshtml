@model Twit.Models.ViewModels.LoginViewModel
@{
	Layout = null;
	ViewData["Title"] = "Sign in";
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sprout — Login</title>
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --cream:    #F1F3E0;
      --sage-lt:  #D2DCB6;
      --sage-md:  #A1BC98;
      --sage-dk:  #778873;
    }

    body {
      min-height: 100vh;
      background: var(--cream);
      font-family: 'Segoe UI', system-ui, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* Background blobs */
    body::before,
    body::after {
      content: '';
      position: fixed;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.45;
      pointer-events: none;
    }
    body::before {
      width: 520px;
      height: 520px;
      background: var(--sage-md);
      top: -140px;
      left: -160px;
    }
    body::after {
      width: 420px;
      height: 420px;
      background: var(--sage-lt);
      bottom: -120px;
      right: -120px;
    }

    .page-wrapper {
      display: flex;
      width: 880px;
      min-height: 540px;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(119,136,115,0.22);
      position: relative;
      z-index: 1;
    }

    /* Left panel */
    .panel-left {
      flex: 1;
      background: var(--sage-dk);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 48px 40px;
      gap: 20px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .logo-icon {
      width: 44px;
      height: 44px;
    }
    .logo-text {
      font-size: 2rem;
      font-weight: 800;
      color: var(--cream);
      letter-spacing: -0.5px;
    }

    .panel-left p {
      color: var(--sage-lt);
      font-size: 0.95rem;
      text-align: center;
      line-height: 1.7;
      max-width: 240px;
    }

    .decorative-dots {
      display: grid;
      grid-template-columns: repeat(5, 8px);
      gap: 8px;
      margin-top: 24px;
    }
    .decorative-dots span {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--sage-md);
      opacity: 0.6;
    }
    .decorative-dots span:nth-child(3) { opacity: 1; background: var(--cream); }

    /* Right panel */
    .panel-right {
      flex: 1.2;
      background: #fff;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 52px 48px;
    }

    .form-header {
      margin-bottom: 32px;
    }
    .form-header h2 {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--sage-dk);
      letter-spacing: -0.4px;
    }
    .form-header p {
      color: #888;
      font-size: 0.9rem;
      margin-top: 6px;
    }

    .form-group {
      margin-bottom: 20px;
    }
    .form-group label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--sage-dk);
      margin-bottom: 7px;
      letter-spacing: 0.3px;
      text-transform: uppercase;
    }
    .form-group input {
      width: 100%;
      padding: 13px 16px;
      border: 1.5px solid var(--sage-lt);
      border-radius: 10px;
      font-size: 0.95rem;
      color: #333;
      background: var(--cream);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-group input:focus {
      border-color: var(--sage-md);
      box-shadow: 0 0 0 3px rgba(161,188,152,0.18);
      background: #fff;
    }
    .form-group input::placeholder {
      color: #bbb;
    }

    .form-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }
    .remember {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 0.87rem;
      color: #666;
      cursor: pointer;
    }
    .remember input[type="checkbox"] {
      width: 15px;
      height: 15px;
      accent-color: var(--sage-dk);
      cursor: pointer;
    }
    .forgot-link {
      font-size: 0.87rem;
      color: var(--sage-dk);
      text-decoration: none;
      font-weight: 600;
    }
    .forgot-link:hover { text-decoration: underline; }

    .btn-primary {
      width: 100%;
      padding: 14px;
      background: var(--sage-dk);
      color: var(--cream);
      border: none;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.3px;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
      box-shadow: 0 4px 14px rgba(119,136,115,0.3);
    }
    .btn-primary:hover {
      background: #5e6d5a;
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(119,136,115,0.35);
    }
    .btn-primary:active { transform: translateY(0); }

    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 22px 0;
      color: #ccc;
      font-size: 0.82rem;
    }
    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--sage-lt);
    }

    .btn-social {
      width: 100%;
      padding: 13px;
      background: var(--cream);
      border: 1.5px solid var(--sage-lt);
      border-radius: 10px;
      font-size: 0.92rem;
      font-weight: 600;
      color: #444;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: background 0.2s, border-color 0.2s;
      margin-bottom: 12px;
    }
    .btn-social:hover {
      background: var(--sage-lt);
      border-color: var(--sage-md);
    }
    .btn-social svg { flex-shrink: 0; }

    .signup-prompt {
      text-align: center;
      margin-top: 24px;
      font-size: 0.88rem;
      color: #888;
    }
    .signup-prompt a {
      color: var(--sage-dk);
      font-weight: 700;
      text-decoration: none;
    }
    .signup-prompt a:hover { text-decoration: underline; }

    @@media (max-width: 700px) {
      .page-wrapper { flex-direction: column; width: 95vw; }
      .panel-left { padding: 36px 24px; min-height: 180px; }
      .panel-right { padding: 36px 24px; }
    }
  </style>
</head>
<body>

  <div class="page-wrapper">

    <!-- Left branding panel -->
    <div class="panel-left">
      <div class="logo">
        <svg class="logo-icon" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="22" cy="22" r="22" fill="#F1F3E0" fill-opacity="0.15"/>
          <path d="M22 36 C22 36 10 26 10 18 C10 11.4 15.4 6 22 6 C28.6 6 34 11.4 34 18 C34 26 22 36 22 36Z" fill="#D2DCB6"/>
          <path d="M22 30 C22 30 14 22 14 17 C14 12.6 17.6 9 22 9 C26.4 9 30 12.6 30 17 C30 22 22 30 22 30Z" fill="#A1BC98"/>
          <path d="M22 10 L22 36" stroke="#F1F3E0" stroke-width="1.5" stroke-dasharray="3 3"/>
          <path d="M16 16 C16 16 19 18 22 16" stroke="#F1F3E0" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M28 20 C28 20 25 18 22 20" stroke="#F1F3E0" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span class="logo-text">Sprout</span>
      </div>
      <p>Share your moments, grow your connections, and blossom together.</p>
      <div class="decorative-dots">
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>

    <!-- Right form panel -->
    <div class="panel-right">
      <div class="form-header">
        <h2>Welcome back</h2>
        <p>Sign in to continue to your garden</p>
      </div>

      <form asp-controller="Login" asp-action="LoginPage" method="post">
        <div asp-validation-summary="All" class="text-danger" style="font-size:0.85rem;margin-bottom:12px;color:#c0392b;"></div>
        <div class="form-group">
          <label asp-for="Email">Email address</label>
          <input asp-for="Email" type="email" placeholder="you@example.com" />
          <span asp-validation-for="Email" style="font-size:0.78rem;color:#c0392b;"></span>
        </div>

        <div class="form-group">
          <label asp-for="Password">Password</label>
          <input asp-for="Password" type="password" placeholder="••••••••" />
          <span asp-validation-for="Password" style="font-size:0.78rem;color:#c0392b;"></span>
        </div>

        <div class="form-row">
          <label class="remember">
            <input asp-for="RememberMe" type="checkbox" /> Remember me
          </label>
          <a href="#" class="forgot-link">Forgot password?</a>
        </div>

        <button type="submit" class="btn-primary">Sign In</button>
      </form>

      <div class="divider">or continue with</div>

      <button class="btn-social">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4"/>
          <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 009 18z" fill="#34A853"/>
          <path d="M3.964 10.71A5.41 5.41 0 013.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 000 9c0 1.452.348 2.827.957 4.042l3.007-2.332z" fill="#FBBC05"/>
          <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 00.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z" fill="#EA4335"/>
        </svg>
        Continue with Google
      </button>

      <div class="signup-prompt">
        Don't have an account? <a asp-controller="SignUp" asp-action="Index">Sign up for free</a>
      </div>
    </div>

  </div>

</body>
</html>
