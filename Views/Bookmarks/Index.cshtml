@model IEnumerable<Twit.Models.ViewModels.PostViewModel>
@{
    ViewData["Title"] = "Bookmarks";
    Layout = null;
    ViewData["ActiveNav"] = "bookmarks";
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bookmarks — Sprout</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --sidebar-w:   240px;
      --sidebar-col: 64px;
      --sidebar-r:   280px;
    }

    body {
      background: var(--cream);
      font-family: 'Nunito', system-ui, sans-serif;
      color: var(--text);
      min-height: 100vh;
    }

    button, input, textarea, select {
      font-family: inherit;
    }

    .layout {
      display: grid;
      grid-template-columns: 1fr;
      margin-left: var(--sidebar-w);
      margin-right: var(--sidebar-r);
      min-height: calc(100vh - 60px);
      transition: margin-left var(--t-layout);
    }
    .layout.collapsed {
      margin-left: var(--sidebar-col);
    }

    /* ── MAIN FEED ── */
    .feed {
      border-left: var(--border);
      border-right: var(--border);
      background: var(--white);
    }

    .feed-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 20px 14px;
      border-bottom: var(--border);
      position: sticky;
      top: 60px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(8px);
      z-index: 10;
    }
    .feed-header h2 {
      font-size: 1.1rem;
      font-weight: 900;
      color: var(--sage-dk);
      letter-spacing: -0.3px;
    }

    /* Post card */
    .post-card {
      padding: 18px 20px;
      border-bottom: var(--border);
      background: var(--white);
      transition: background var(--t-ui);
    }
    .post-card:hover { background: var(--cream); }

    .post-header {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 10px;
    }
    .post-avatar {
      width: 44px;
      height: 44px;
      border-radius: var(--r-pill);
      flex-shrink: 0;
      border: 2px solid var(--sage-lt);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.95rem;
      background: var(--sage-md);
      color: var(--white);
    }

    .post-meta { flex: 1; }
    .post-name {
      font-weight: 800;
      font-size: 0.95rem;
      color: var(--text);
    }
    .post-handle {
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--muted);
    }

    .post-text {
      font-size: 0.95rem;
      line-height: 1.65;
      color: var(--text);
      margin-bottom: 12px;
      font-weight: 500;
    }

    .post-actions {
      display: flex;
      align-items: center;
    }
    .post-action {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 7px 12px 7px 8px;
      border: none;
      background: none;
      cursor: pointer;
      color: var(--muted);
      font-size: 0.85rem;
      font-weight: 600;
      border-radius: var(--r-pill);
      transition: background var(--t-ui), color var(--t-ui);
    }
    .post-action:hover { background: var(--sage-lt); }
    .post-action.liked { color: var(--accent); }
    .post-action.liked:hover { background: rgba(224, 122, 95, 0.1); }
    .post-action.bookmarked { color: var(--sage-dk); }
    .post-action--push { margin-left: auto; }

    /* ── RESPONSIVE ── */
    @@media (max-width: 900px) {
      .layout {
        margin-left: var(--sidebar-col);
        margin-right: 0;
      }
      .sidebar-right { display: none; }
    }
    @@media (max-width: 600px) {
      .layout { margin-left: 0; }
    }
  </style>
</head>
<body>

  @await Html.PartialAsync("_Navbar")

  <div class="layout" id="mainLayout">

    @await Html.PartialAsync("_SidebarLeft")

    <main class="feed">
      <div class="feed-header">
        <h2>Bookmarks</h2>
      </div>

      @if (Model == null || !Model.Any())
      {
        <div class="post-card" style="text-align:center;padding:60px 20px;color:var(--muted);">
          <p style="font-weight: 600; font-size: 0.95rem;">You haven't bookmarked any sprouts yet.</p>
          <p style="font-size: 0.82rem; margin-top: 6px;">Sprouts you bookmark will show up here.</p>
        </div>
      }
      else
      {
        @foreach (var post in Model)
        {
          var timeAgo = (DateTime.UtcNow - post.CreatedAt);
          var timeText = timeAgo.TotalMinutes < 60 ? $"{(int)timeAgo.TotalMinutes}m"
                       : timeAgo.TotalHours < 24 ? $"{(int)timeAgo.TotalHours}h"
                       : $"{(int)timeAgo.TotalDays}d";
        <div class="post-card">
          <div class="post-header">
            <div class="post-avatar">@post.AuthorInitials</div>
            <div class="post-meta">
              <a asp-controller="Profile" asp-action="Index" asp-route-handle="@post.AuthorHandle" style="text-decoration:none; color:inherit;">
                <div class="post-name">@post.AuthorName</div>
                <div class="post-handle" style="display:inline-block;">@("@")@post.AuthorHandle</div>
              </a>
              <span class="post-handle">· @timeText</span>
            </div>
          </div>
          <p class="post-text">@post.Content</p>
          <div class="post-actions">
            <form asp-action="LikePost" asp-controller="Like" method="post" style="display:inline" class="like-form">
              <input type="hidden" name="postId" value="@post.Id" />
              <button type="submit" class="post-action @(post.IsLikedByCurrentUser ? "liked" : "")">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="@(post.IsLikedByCurrentUser ? "currentColor" : "none")" stroke="currentColor" stroke-width="2">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
                <span class="like-count">@post.LikesCount</span>
              </button>
            </form>
            <button class="post-action" onclick="toggleComments('@post.Id')">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
              <span id="commentCount-@post.Id">@post.CommentCount</span>
            </button>
            <form asp-action="RePost" asp-controller="Home" method="post" style="display:inline">
              <input type="hidden" name="postId" value="@post.Id" />
              <button type="submit" class="post-action">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                </svg>
                @post.RepostCount
              </button>
            </form>
            <form asp-controller="Bookmark" asp-action="Toggle" method="post" style="display:inline; margin-left:auto;">
              <input type="hidden" name="postId" value="@post.Id" />
              <button type="submit" class="post-action @(post.IsBookmarkedByCurrentUser ? "bookmarked" : "")" title="Bookmark post">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="@(post.IsBookmarkedByCurrentUser ? "currentColor" : "none")" stroke="currentColor" stroke-width="2">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                </svg>
              </button>
            </form>
          </div>

          <!-- Inline comment section (hidden by default) -->
          <div class="comments-section" id="comments-@post.Id" style="display:none;margin-top:12px;padding-top:12px;border-top:var(--border);">
            <div class="comments-list" id="commentsList-@post.Id">
              <div class="comments-loading" style="text-align:center;padding:8px;color:var(--muted);font-size:0.82rem;display:none;">Loading comments…</div>
            </div>
            
            <form asp-controller="Comment" asp-action="CreateComment" method="post" style="display:flex;gap:8px;margin-top:10px;">
              <input type="hidden" name="postId" value="@post.Id" />
              <input type="text" name="content" placeholder="Reply to this sprout..." required style="flex:1;padding:8px 12px;border:var(--border);border-radius:var(--r-pill);background:var(--cream);font-size:0.85rem;color:var(--text);outline:none;" />
              <button type="submit" style="padding:6px 14px;background:var(--sage-dk);color:var(--cream);border:none;border-radius:var(--r-pill);font-size:0.8rem;font-weight:700;cursor:pointer;">Reply</button>
            </form>
          </div>
        </div>
        }
      }
    </main>

    @await Html.PartialAsync("_SidebarRight")

  </div>

  <script>
    // Purely Optimistic AJAX Like handling
    document.addEventListener('submit', async (e) => {
      const form = e.target.closest('.like-form');
      if (form) {
        e.preventDefault();
        const button = form.querySelector('button');
        const svg = button.querySelector('svg');
        const countSpan = button.querySelector('.like-count');
        
        const wasLiked = button.classList.contains('liked');
        const currentCount = parseInt(countSpan.textContent);
        
        button.classList.toggle('liked', !wasLiked);
        svg.setAttribute('fill', !wasLiked ? 'currentColor' : 'none');
        countSpan.textContent = !wasLiked ? currentCount + 1 : Math.max(0, currentCount - 1);
        
        const formData = new FormData(form);
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new URLSearchParams(formData),
            headers: {
              'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value,
              'X-Requested-With': 'XMLHttpRequest'
            }
          });
          
          if (!response.ok) {
            if (response.status === 401) {
              window.location.href = '/Login/LoginPage';
              return;
            }
            throw new Error(`Server returned ${response.status}`);
          }
          
          const contentType = response.headers.get("content-type");
          if (contentType && contentType.includes("application/json")) {
            const result = await response.json();
            if (result.success) {
              countSpan.textContent = result.count;
            }
          }
        } catch (error) {
          button.classList.toggle('liked', wasLiked);
          svg.setAttribute('fill', wasLiked ? 'currentColor' : 'none');
          countSpan.textContent = currentCount;
          console.error('Like failed:', error);
        }
      }
    });
  </script>

  <script>
    // Comment toggle & AJAX loading
    function formatTimeAgo(dateStr) {
      const diff = Date.now() - new Date(dateStr).getTime();
      const mins = Math.floor(diff / 60000);
      if (mins < 60) return mins + 'm';
      const hrs = Math.floor(mins / 60);
      if (hrs < 24) return hrs + 'h';
      return Math.floor(hrs / 24) + 'd';
    }

    async function toggleComments(postId) {
      const section = document.getElementById('comments-' + postId);
      const list = document.getElementById('commentsList-' + postId);

      if (section.style.display === 'none') {
        section.style.display = 'block';

        if (!list.querySelector('.comment-item')) {
          const loader = list.querySelector('.comments-loading');
          if (loader) loader.style.display = 'block';

          try {
            const response = await fetch('/Home/GetComments?postId=' + encodeURIComponent(postId));
            const comments = await response.json();

            if (loader) loader.style.display = 'none';

            if (comments.length === 0) {
              const empty = document.createElement('div');
              empty.className = 'comments-empty';
              empty.style.cssText = 'text-align:center;padding:12px 0;color:var(--muted);font-size:0.82rem;font-weight:600;';
              empty.textContent = 'No comments yet — be the first to reply!';
              list.appendChild(empty);
            } else {
              comments.forEach(c => {
                const div = document.createElement('div');
                div.className = 'comment-item';
                div.style.cssText = 'display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--cream);';
                div.innerHTML =
                  '<div style="width:30px;height:30px;border-radius:50%;background:var(--sage-md);display:flex;align-items:center;justify-content:center;color:#fff;font-size:0.7rem;font-weight:800;flex-shrink:0;">' +
                    c.authorInitials +
                  '</div>' +
                  '<div style="flex:1;min-width:0;">' +
                    '<div style="display:flex;align-items:baseline;gap:6px;">' +
                      '<span style="font-size:0.84rem;font-weight:800;color:var(--text);">' + c.authorName + '</span>' +
                      '<span style="font-size:0.75rem;color:var(--muted);font-weight:500;">' + formatTimeAgo(c.createdAt) + '</span>' +
                    '</div>' +
                    '<div style="font-size:0.84rem;color:var(--text);margin-top:2px;line-height:1.5;font-weight:500;">' + c.content + '</div>' +
                  '</div>';
                list.appendChild(div);
              });
            }
          } catch (err) {
            if (loader) loader.style.display = 'none';
            console.error('Failed to load comments:', err);
          }
        }
      } else {
        section.style.display = 'none';
      }
    }
  </script>
</body>
</html>
