@inject Twit.Services.ISidebarService SidebarService
@inject Twit.UnitOfWork.IUnitOfWork UnitOfWork
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    string? profileId = null;
    if (userId != null)
    {
        var profile = await UnitOfWork.UserProfileRepo.GetAll().AsNoTracking()
            .FirstOrDefaultAsync(p => p.UserId == userId);
        profileId = profile?.Id;
    }

    var trendingTags = await SidebarService.GetTrendingTags(5);
    var suggestedUsers = await SidebarService.GetSuggestedUsers(profileId ?? "", 3);
}

<!-- Right sidebar -->
<aside class="sidebar-right">

  <div class="mini-widget">
    <h4>Your Growth</h4>
    <div class="stat">+24</div>
    <p>New followers this week</p>
  </div>

  <div class="widget">
    <h3>Trending on Sprout</h3>
    @if (trendingTags != null && trendingTags.Any())
    {
        @foreach (var tag in trendingTags)
        {
            <div class="trend-item" onclick="location.href='@Url.Action("Index", "Search", new { query = "#" + tag.Tag })'">
                <div class="trend-category">Trending</div>
                <div class="trend-tag">#@tag.Tag</div>
                <div class="trend-count">@tag.Count sprouts</div>
            </div>
        }
    }
    else
    {
        <p style="font-size:0.85rem;color:var(--muted);text-align:center;padding:10px 0;">No active trends.</p>
    }
  </div>

  <div class="widget">
    <h3>Who to Follow</h3>
    @if (suggestedUsers != null && suggestedUsers.Any())
    {
        @foreach (var user in suggestedUsers)
        {
            var initials = (user.FirstName.Length > 0 ? user.FirstName[0].ToString() : "") 
                         + (user.LastName.Length > 0 ? user.LastName[0].ToString() : "");
            <div class="suggest-item">
                <div class="suggest-avatar" style="background:var(--sage-md);color:var(--white)">@initials.ToUpper()</div>
                <div class="suggest-info">
                    <div class="suggest-name">@user.FirstName @user.LastName</div>
                    <div class="suggest-handle">@@@user.User.UserName</div>
                </div>
                <form class="ajax-follow-form" asp-controller="Follow" asp-action="Follow" method="post" style="display:inline">
                    <input type="hidden" name="profileId" value="@user.Id" />
                    <button type="submit" class="btn-follow">Follow</button>
                </form>
            </div>
        }
        <div class="widget-footer" onclick="location.href='@Url.Action("Index", "Explore")'">Discover more people →</div>
    }
    else
    {
        <p style="font-size:0.85rem;color:var(--muted);text-align:center;padding:10px 0;">No suggestions available.</p>
    }
  </div>

  <div class="footer-links">
    <a href="#">Privacy</a>
    <a href="#">Terms</a>
    <a href="#">Cookies</a>
    <a href="#">About</a><br>
    © 2026 Sprout Inc.
  </div>

  <style>
    .sidebar-right .btn-loader {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 2px solid currentColor;
      border-bottom-color: transparent;
      border-radius: 50%;
      animation: sidebar-btn-spin 0.75s linear infinite;
      vertical-align: middle;
    }
    @@keyframes sidebar-btn-spin {
      to { transform: rotate(360deg); }
    }
  </style>

  <script src="/lib/jquery/dist/jquery.min.js"></script>
  <script>
    $(document).on('submit', '.sidebar-right .ajax-follow-form', function(e) {
      e.preventDefault();
      var $btn = $(this).find('button');

      $btn.prop('disabled', true).html('<span class="btn-loader"></span>');

      $.ajax({
        url: '/Follow/Follow',
        type: 'POST',
        data: { profileId: $(this).find('input[name="profileId"]').val() },
        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() }
      })
      .done(function(data) {
        if (data.success) {
          $btn.closest('.suggest-item')
              .animate({ opacity: 0 }, 300)
              .slideUp(300, function() { $(this).remove(); });
        } else { $btn.text('Follow').prop('disabled', false); }
      })
      .fail(function(xhr) {
        $btn.text('Follow').prop('disabled', false);
        if (xhr.status === 401) window.location.href = '/login';
      });
    });
  </script>
</aside>
