@inject Twit.Services.INotificationService NotificationService
@inject Twit.Services.IMessageService MessageService
@inject Twit.Services.IUserProfileCacheService UserProfileCache
@using System.Security.Claims
@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    string? profileId = null;
    int unreadCount = 0;
    int unreadMessagesCount = 0;

    if (userId != null)
    {
        profileId = await UserProfileCache.GetProfileId(userId);
        if (profileId != null)
        {
            unreadCount = await NotificationService.GetUnreadCount(profileId);
            unreadMessagesCount = await MessageService.GetUnreadCount(profileId);
        }
    }
}
<style>
  .nb-drop-wrap {
    position: relative;
  }

  .nb-dropdown {
    display: none;
    flex-direction: column;
    gap: 6px;
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 300px;
    background: #A1BC98;
    border-radius: 14px;
    padding: 10px;
    z-index: 999;
    box-shadow: 0 8px 24px rgba(44, 48, 40, 0.18);
  }

  .nb-dropdown.open {
    display: flex;
  }

  .nb-drop-header {
    font-size: 0.78rem;
    font-weight: 700;
    color: #ffffff;
    padding: 2px 4px 6px 4px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nb-drop-item {
    background: #F1F3E0;
    color: #778873;
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .nb-drop-item:hover {
    background: #e6e9d0;
  }

  .nb-drop-item .nb-item-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #778873;
  }

  .nb-drop-item .nb-item-sub {
    font-size: 0.78rem;
    font-weight: 400;
    color: #778873;
    opacity: 0.8;
  }

  .nb-drop-footer {
    text-align: center;
    font-size: 0.76rem;
    color: #ffffff;
    padding: 4px 0 2px;
    cursor: pointer;
    font-weight: 600;
    opacity: 0.85;
  }

  .nb-drop-footer:hover { opacity: 1; }
</style>

<!-- Navbar -->
<nav class="navbar">
  <a asp-controller="Home" asp-action="Index" class="nav-logo">
    <svg width="28" height="28" viewBox="0 0 44 44" fill="none">
      <path d="M22 36 C22 36 10 26 10 18 C10 11.4 15.4 6 22 6 C28.6 6 34 11.4 34 18 C34 26 22 36 22 36Z" fill="#D2DCB6"/>
      <path d="M22 30 C22 30 14 22 14 17 C14 12.6 17.6 9 22 9 C26.4 9 30 12.6 30 17 C30 22 22 30 22 30Z" fill="#A1BC98"/>
      <path d="M22 10 L22 36" stroke="#778873" stroke-width="1.5" stroke-dasharray="3 3"/>
    </svg>
    <span>Sprout</span>
  </a>

  <div class="nav-search">
    <form asp-controller="Search" asp-action="Index" method="get" style="display: block; width: 100%;">
      <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input type="text" name="query" placeholder="Search Sprout…" value="@Context.Request.Query["query"]" />
    </form>
  </div>

  <div class="nav-actions">

    <!-- Notifications -->
    <div class="nb-drop-wrap">
      <button class="nav-icon-btn" id="nb-notif-btn" title="Notifications">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        @if (unreadCount > 0)
        {
          <span class="badge">@unreadCount</span>
        }
      </button>
      <div class="nb-dropdown" id="nb-notif-drop">
        <div class="nb-drop-header">Notifications</div>
        <div class="nb-drop-loading" style="text-align: center; padding: 12px; color: #ffffff; opacity: 0.8; font-size: 0.8rem;">
          Loading...
        </div>
        <div class="nb-drop-items-container"></div>
        <div class="nb-drop-footer" onclick="location.href='@Url.Action("Index", "Notifications")'">See all notifications</div>
      </div>
    </div>

    <!-- Messages -->
    <div class="nb-drop-wrap">
      <button class="nav-icon-btn" id="nb-msg-btn" title="Messages">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        @if (unreadMessagesCount > 0)
        {
          <span class="badge">@unreadMessagesCount</span>
        }
      </button>
      <div class="nb-dropdown" id="nb-msg-drop">
        <div class="nb-drop-header">Messages</div>
        <div class="nb-drop-loading" style="text-align: center; padding: 12px; color: #ffffff; opacity: 0.8; font-size: 0.8rem;">
          Loading...
        </div>
        <div class="nb-drop-items-container"></div>
        <div class="nb-drop-footer" onclick="location.href='@Url.Action("Index", "Messages")'">See all messages</div>
      </div>
    </div>

    <!-- Profile -->
    <div class="nb-drop-wrap">
      <button class="nav-avatar" id="nb-profile-btn" title="Profile">
        @{ var _un = User.Identity?.Name ?? ""; }
        @(_un.Length > 0 ? _un[0].ToString().ToUpper() : "?")
      </button>
      <div class="nb-dropdown" id="nb-profile-drop" style="width:200px;">
        <div class="nb-drop-header">My Account</div>
        <a asp-controller="Profile" asp-action="Index" class="nb-drop-item" style="text-decoration:none;">
          <span class="nb-item-title">View Profile</span>
        </a>
        <form asp-controller="Login" asp-action="Logout" method="post" style="margin:0;">
          <button type="submit" class="nb-drop-item" style="width:100%;border:none;background:none;padding:10px 14px;text-align:left;cursor:pointer;border-radius:8px;color:#e07a5f;">
            <span class="nb-item-title" style="color:#e07a5f;">Log Out</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</nav>

<script>
  (function () {
    const notifBtn    = document.getElementById('nb-notif-btn');
    const notifDrop   = document.getElementById('nb-notif-drop');
    const msgBtn      = document.getElementById('nb-msg-btn');
    const msgDrop     = document.getElementById('nb-msg-drop');
    const profileBtn  = document.getElementById('nb-profile-btn');
    const profileDrop = document.getElementById('nb-profile-drop');

    const allDrops = [notifDrop, msgDrop, profileDrop];

    let cachedNotifications = null;
    let lastNotifFetchTime = 0;
    let cachedMessages = null;
    let lastMsgFetchTime = 0;
    const CACHE_DURATION_MS = 60000; // 1 minute (60 seconds)

    function toggle(drop) {
      const isOpen = drop.classList.contains('open');
      allDrops.forEach(d => d.classList.remove('open'));
      if (!isOpen) {
        drop.classList.add('open');
        if (drop === notifDrop) {
          loadNotifications();
        } else if (drop === msgDrop) {
          loadMessages();
        }
      }
    }

    notifBtn.addEventListener('click',   function (e) { e.stopPropagation(); toggle(notifDrop); });
    msgBtn.addEventListener('click',     function (e) { e.stopPropagation(); toggle(msgDrop); });
    profileBtn.addEventListener('click', function (e) { e.stopPropagation(); toggle(profileDrop); });

    document.addEventListener('click', function () {
      allDrops.forEach(d => d.classList.remove('open'));
    });

    allDrops.forEach(d => d.addEventListener('click', function (e) { e.stopPropagation(); }));

    // Listen to real-time events to invalidate cache
    window.addEventListener('newMessageReceived', function () {
      cachedMessages = null;
      lastMsgFetchTime = 0;
    });

    window.addEventListener('newNotificationReceived', function () {
      cachedNotifications = null;
      lastNotifFetchTime = 0;
    });

    function renderNotificationsList(notifs, container) {
      container.innerHTML = '';
      if (notifs.length === 0) {
        container.innerHTML = `
          <div class="nb-drop-item" style="cursor: default;">
            <span class="nb-item-title">No new notifications</span>
          </div>`;
        return;
      }

      notifs.forEach(n => {
        let text = '';
        switch (n.type) {
          case 'Like': text = 'liked your Sprout'; break;
          case 'Follow': text = 'started following you'; break;
          case 'Repost': text = 'reposted your Sprout'; break;
          case 'Comment': text = 'commented on your Sprout'; break;
          case 'Mention': text = 'mentioned you'; break;
          default: text = 'interacted with your Sprout';
        }

        const item = document.createElement('div');
        item.className = 'nb-drop-item';
        item.onclick = () => { location.href = '/Notifications'; };
        item.innerHTML = `
          <span class="nb-item-title">
            <strong>${escapeHtml(n.actorName)}</strong> ${text}
          </span>
          <span class="nb-item-sub">${escapeHtml(n.timeAgo)}</span>
        `;
        container.appendChild(item);
      });
    }

    async function loadNotifications() {
      const container = notifDrop.querySelector('.nb-drop-items-container');
      const loader = notifDrop.querySelector('.nb-drop-loading');
      if (!container || !loader) return;

      const now = Date.now();
      if (cachedNotifications && (now - lastNotifFetchTime < CACHE_DURATION_MS)) {
        renderNotificationsList(cachedNotifications, container);
        loader.style.display = 'none';
        return;
      }

      container.innerHTML = '';
      loader.style.display = 'block';

      try {
        const response = await fetch('/Notifications/GetRecentNotifications');
        if (!response.ok) throw new Error('Failed to fetch');
        const notifs = await response.json();
        
        cachedNotifications = notifs;
        lastNotifFetchTime = now;
        
        loader.style.display = 'none';
        renderNotificationsList(notifs, container);
      } catch (err) {
        loader.style.display = 'none';
        container.innerHTML = `
          <div class="nb-drop-item" style="cursor: default; color: #ff6b6b;">
            <span class="nb-item-title">Error loading notifications</span>
          </div>`;
        console.error(err);
      }
    }

    function renderMessagesList(convs, container) {
      container.innerHTML = '';
      if (convs.length === 0) {
        container.innerHTML = `
          <div class="nb-drop-item" style="cursor: default;">
            <span class="nb-item-title">No new messages</span>
          </div>`;
        return;
      }

      convs.forEach(c => {
        const item = document.createElement('div');
        item.className = 'nb-drop-item';
        item.onclick = () => { location.href = '/Messages/Chat?conversationId=' + encodeURIComponent(c.id); };
        item.innerHTML = `
          <span class="nb-item-title">${escapeHtml(c.partnerName)}</span>
          <span class="nb-item-sub">${escapeHtml(c.lastMsgText)}</span>
        `;
        container.appendChild(item);
      });
    }

    async function loadMessages() {
      const container = msgDrop.querySelector('.nb-drop-items-container');
      const loader = msgDrop.querySelector('.nb-drop-loading');
      if (!container || !loader) return;

      const now = Date.now();
      if (cachedMessages && (now - lastMsgFetchTime < CACHE_DURATION_MS)) {
        renderMessagesList(cachedMessages, container);
        loader.style.display = 'none';
        return;
      }

      container.innerHTML = '';
      loader.style.display = 'block';

      try {
        const response = await fetch('/Messages/GetRecentUnreadConversations');
        if (!response.ok) throw new Error('Failed to fetch');
        const convs = await response.json();
        
        cachedMessages = convs;
        lastMsgFetchTime = now;
        
        loader.style.display = 'none';
        renderMessagesList(convs, container);
      } catch (err) {
        loader.style.display = 'none';
        container.innerHTML = `
          <div class="nb-drop-item" style="cursor: default; color: #ff6b6b;">
            <span class="nb-item-title">Error loading messages</span>
          </div>`;
        console.error(err);
      }
    }

    function escapeHtml(text) {
      if (!text) return '';
      return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  })();
</script>
